#
# factor4 is the residual after constant SMM, seasonality, seasoning and lock-in incentive
rawData$smmFactor4 <- rawData$smmFactor3/rawData$smm.model.lockin
cltv <- EmpiricalCalTurn(rawData, 'cltv', 'smmFactor4')
# Fit empirical CLTV function to a model spline function. The knots for the model are
cltv.knots <- c(50, 60, 70, 80, 90, 100, 110)
cltv.optim <- OptimalFunc(cltv$factor.vec, cltv$smm.vec, cltv.knots)
# print the result and save it to result folder
TurnPrintFunc('cltv', cltv$factor.vec, cltv$smm.vec, cltv.knots, cltv.optim)
#
# write parameter data into data file
#
write.csv(seasonality, "data/turnover_seasonality_optimal_data.csv", row.names = FALSE)
write.csv(data.frame(wala.knots, wala.optim), "data/turnover_wala_optimal_data.csv", row.names = FALSE)
write.csv(data.frame(lockin.knots, lockin.optim), "data/turnover_lockin_optimal_data.csv", row.names = FALSE)
write.csv(data.frame(cltv.knots, cltv.optim), "data/turnover_cltv_optimal_data.csv", row.names = FALSE)
constTurnOverSMM <- rawData$constTurnOverSMM[1]
write.csv(constTurnOverSMM, "data/turnover_model_prarameter_data.csv")
#	rawData <- read.csv("data.csv")
write.csv(rawData, "data2.csv", row.names = FALSE)
write.csv(data, "data3.csv", row.names = FALSE)
}
