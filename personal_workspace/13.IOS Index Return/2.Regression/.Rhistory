CalculateBondPrice <- function (cpn,mat,yld,par){
px <- cpn/yld + (par - cpn/yld) * (1 + yld)^(-2 * mat)
}
price <- 1200
C <- 40
T <- 30
par <- 1000
r <- seq(0.02, 0.04, length = 300)
prices <- CalculateBondPrice(cpn=c, mat=T, yld=r, par=par)
yield.to.maturaty <- spline(price, r, xout=price)
plot(r,price, xlab="yield to maturity", ylab="bond price",
type="l", lwd=2)
abline(h=1200)
abline(v=yield.to.maturity)
