fileName = paste(getwd(),"/",name,sep="");
if(file.exists(fileName)) {
source(fileName);
} else {
cat("can not find ", fileName, "\n");
}
}
rawData <- read.csv("CreditAvailabilityRegression1.csv")
#regression, exam the result
xy.lm <- lm(rawData$CAI ~ rawData$ClosingRate)
xy.lm$coefficients
summary(xy.lm)
