----------------------------------------------------------------------------------------------
-- Check to see if Loans have  currentBalance IS NULL OR currentBalance < 0.0
----------------------------------------------------------------------------------------------
        declare   @cnt int
        SELECT
            @cnt =  count(1)
        FROM #GNM_LoanHist  WHERE currentBalance IS NULL OR currentBalance < 0.0

        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of GNM Loans with INVALID VALUE for current Balance: %1!', @cnt
            RETURN
        END
----------------------------------------------------------------------------------------------
-- Check to see if Loans have  schamBalance IS NULL OR schamBalance < 0.0
----------------------------------------------------------------------------------------------
        SELECT
            @cnt =  count(1)
        FROM #GNM_LoanHist  WHERE schamBalance IS NULL OR schamBalance < 0.0

        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of GNM Loans with INVALID VALUE for scheduled Balance: %1!', @cnt
            RETURN
        END
----------------------------------------------------------------------------------------------
-- Check to see if Loans have  cltv IS NULL OR cltv < 0.0 OR cltv > 1000
----------------------------------------------------------------------------------------------
        SELECT
            @cnt =  count(1)
        FROM #GNM_LoanHist  WHERE cltv IS NULL OR cltv < 0.0 OR cltv > 1000

        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of GNM Loans with INVALID VALUE for CLTV: %1!', @cnt
            RETURN
        END
----------------------------------------------------------------------------------------------
-- Check to see if Loans have  hpa IS NULL  OR hpa < 0.5 OR hpa > 10
----------------------------------------------------------------------------------------------
        SELECT
            @cnt =  count(1)
        FROM #GNM_LoanHist  WHERE  hpa IS NULL OR hpa < 0.5 OR hpa > 10

        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of GNM Loans with INVALID VALUE for HPA: %1!', @cnt
            RETURN
        END
----------------------------------------------------------------------------------------------
-- Check to see if Loans have  hpa_2yr IS NULL OR hpa_2yr < 0.50 OR hpa_2yr > 1.5
----------------------------------------------------------------------------------------------
        SELECT
            @cnt =  count(1)
        FROM #GNM_LoanHist  WHERE  hpa_2yr IS NULL OR hpa_2yr < 0.50 OR hpa_2yr > 1.5

        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of GNM Loans with INVALID VALUE for 2-year relative HPA: %1!', @cnt
            RETURN
        END
----------------------------------------------------------------------------------------------
-- Check to see if Loans have  loanAge IS NULL OR loanAge < 0.0 OR loanAge > 1000
----------------------------------------------------------------------------------------------
        SELECT
            @cnt =  count(1)
        FROM #GNM_LoanHist  WHERE loanAge IS NULL OR loanAge < 0.0 OR loanAge > 360

        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of GNM Loans with INVALID VALUE for loan age: %1!', @cnt
            RETURN
        END
   
   
