-- Load Data into Scale Tables

declare @count_previous int
   
    SELECT @count_previous = count(distinct(loanSeqNum))
    FROM scale.GNM_LoanHist

declare @count_current int
	 
	 SELECT @count_current = count(distinct(loanSeqNum))
	 FROM #GNM_LoanHist
	 
	 
INSERT INTO scale.JobStatus (Job_Time, Job_Name, Job_Status, Previous_Loan_Count, Current_Loan_Count)
    SELECT
     getdate(),
    'GNM_Loan_Step 3_Create_Loan_History_Table', 
    'SUCCESS', 
    @count_previous,
    @count_current
;
COMMIT;


DELETE FROM scale.GNM_LoanHist
FROM scale.GNM_LoanHist slh, #GNM_LoanHist lh
WHERE 1=1
    AND slh.loanSeqNum = lh.loanSeqNum
    AND slh.asOf = lh.asOf
    AND lh.marketTicker IN (SELECT tickerName FROM #ticker)
    AND slh.asOf >= (SELECT asOf from #tmp_asOf)
;

INSERT INTO scale.GNM_LoanHist (loanSeqNum, asOf, currentBalance, schamBalance, cltv, hpa, loanAge, delMonths, removalReasonType, celloDerived)
SELECT
    loanSeqNum,
    asOf,
    currentBalance,
    schamBalance,
    cltv,
    hpa,
    loanAge, 
    delMonths, 
    removalReasonType,
    celloDerived
FROM #GNM_LoanHist
WHERE marketTicker IN (SELECT tickerName FROM #ticker)
    AND asOf >= (SELECT asOf from #tmp_asOf)
;