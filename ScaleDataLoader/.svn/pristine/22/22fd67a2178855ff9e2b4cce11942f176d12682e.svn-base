-- Check to see if Loans have  origLoanSize IS NULL OR origLoanSize <= 0.0 OR origLoanSize > 10000000
----------------------------------------------------------------------------------------------
        declare   @cnt int
		SELECT
            @cnt =  count(1)
        FROM #GNM_Loan  
		WHERE origLoanSize IS NULL OR origLoanSize <= 0.0 OR origLoanSize > 10000000

        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of GNM Loans with INVALID VALUE for origination Loan Size: %1!', @cnt
            RETURN
        END
----------------------------------------------------------------------------------------------
-- Check to see if Loans have   origFICO IS NULL OR origFICO <= 0.0 OR origFICO > 900
----------------------------------------------------------------------------------------------
        SELECT
            @cnt =  count(1)
        FROM #GNM_Loan  
		WHERE   origFICO IS NULL OR origFICO <= 0.0 OR origFICO > 900

        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of GNM Loans with INVALID VALUE for origination FICO score %1!', @cnt
            RETURN
        END
----------------------------------------------------------------------------------------------
-- Check to see if Loans have   origLTV IS NULL OR origLTV <= 0.0 OR origLTV > 200
----------------------------------------------------------------------------------------------
        SELECT
            @cnt =  count(1)
        FROM #GNM_Loan  
		WHERE   origLTV IS NULL OR origLTV <= 0.0 OR origLTV > 200

        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of GNM Loans with INVALID VALUE for origination LTV: %1!', @cnt
            RETURN
        END
----------------------------------------------------------------------------------------------
-- Check to see if Loans have   loanPurposeType IS NULL OR loanPurposeType <= 0.0 OR loanPurposeType > 200
----------------------------------------------------------------------------------------------
        SELECT
            @cnt =  count(1)
        FROM #GNM_Loan  
		WHERE   loanPurposeType IS NULL
		
        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of GNM Loans with NULL VALUE for loan Purpose Type: %1!', @cnt
            RETURN
        END        
----------------------------------------------------------------------------------------------
-- Check to see if Loans have    origNoteRate IS NULL OR origNoteRate <= 0.0 OR origNoteRate > 20
----------------------------------------------------------------------------------------------
        SELECT
           @cnt =  count(1)
        FROM #GNM_Loan  WHERE    origNoteRate IS NULL OR origNoteRate <= 0.0 OR origNoteRate > 20

        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of GNM Loans with INVALID VALUE for origination Note Rate: %1!', @cnt
            RETURN
        END
----------------------------------------------------------------------------------------------
-- Check to see if Loans have  HPI_orig IS NULL OR HPI_orig < 0.0 OR HPI_orig > 1000
----------------------------------------------------------------------------------------------
        SELECT
            @cnt =  count(1)
        FROM #GNM_Loan  WHERE  HPI_orig IS NULL OR HPI_orig < 0.0 OR HPI_orig > 1000

        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of GNM Loans with INVALID VALUE for origination HPI: %1!', @cnt
            RETURN
        END
