-- Load Data into Scale Tables

DELETE FROM scale.GNM_Loan_dev
WHERE marketTicker IN (SELECT tickerName FROM #ticker)
    AND version IN (SELECT originationVersion from #tmp_version)
;

INSERT INTO scale.GNM_Loan_dev (loanSeqNum, marketTicker, originationDate, origLoanSize, origFICO, origLTV, dti, origNoteRate, HPI_orig, loanPurposeType, tpoType, loanType, firstTimeHomeBuyerFlag, reperformingStatus,version)
SELECT
    loanSeqNum,
    gl.marketTicker AS marketTicker,
    originationDate,
    origLoanSize,
    origFICO,
    origLTV,
    dti,
    origNoteRate,
    HPI_orig,
    loanPurposeType,   
    tpoType,
    loanType,
    firstTimeHomeBuyerFlag,
    reperformingStatus,
	tpv.originationVersion AS version
FROM #GNM_Loan gl
JOIN #tmp_version tpv
   ON gl.marketTicker = tpv.tickerName
WHERE marketTicker IN (SELECT tickerName FROM #ticker)
;

declare @count_previous int
   
    SELECT @count_previous = count(1)
    FROM scale.GNM_Loan_dev 
	WHERE marketTicker IN (SELECT tickerName FROM #ticker)
	AND version IN (SELECT originationVersion FROM #tmp_version)

declare @count_current int
	 
	 SELECT @count_current = count(1)
	 FROM #GNM_Loan
	 
INSERT INTO scale.JobStatus (EndTime, JobName, JobStatus, #LoansBeforeProcess, #LoansUpdated, #LoansAfterProcess)
    SELECT
     getdate(),
    'GNM_Loan_Step 1_Create_Loan_Table',
    'SUCCESS', 
    @count_previous,
    @count_current,
	CASE WHEN(@count_previous>@count_current) THEN @count_previous ELSE @count_current END
;
COMMIT;
