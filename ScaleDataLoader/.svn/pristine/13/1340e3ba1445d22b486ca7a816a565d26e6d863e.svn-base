-- Freddie Conventional
-- Loan Level
-- Part 3 of 7
-- Script to update origination PMI
-- Updates origPMI


-- Before execute the script, need to set the appType to run for
DROP TABLE IF EXISTS #tmp_appType;
SELECT '#####APPTYPE#####' AS appType INTO #tmp_appType
--SELECT '9.98' AS appType INTO #tmp_appType
;

-- Before execute the script, need to set the tickers
DROP TABLE IF EXISTS #ticker;
CREATE TABLE #ticker(
    tickerName varchar(20),
    mtgRateSeries varchar(30)
)
;
INSERT #ticker SELECT 'FGLMC', 'CONVENTIONAL_30YR';   --30 Yr Conventional Freddie
INSERT #ticker SELECT 'FGT6', 'JUMBO_30YR';           --30 Yr Jumbo Freddie
INSERT #ticker SELECT 'FGU6', 'CONVENTIONAL_30YR';    --30 Yr CQ Freddie High LTV[105-125]
INSERT #ticker SELECT 'FGU9', 'CONVENTIONAL_30YR';    --30 Yr CR Freddie High LTV[125-150]
--INSERT #ticker SELECT 'FGTW', 'CONVENTIONAL_20YR';    --20 Yr Conventional Freddie
--INSERT #ticker SELECT 'FGCI', 'CONVENTIONAL_15YR';    --15 Yr Conventional Freddie
COMMIT;

CREATE LF INDEX loan_tickerName_idx ON #ticker(tickerName);
COMMIT;

-- Before execute the script, need to set the version to run for
DROP TABLE IF EXISTS #tmp_version;
SELECT mvc.tickerName, mvc.appType, mvc.originationVersion_LL as originationVersion 
INTO #tmp_version
FROM scale.ModelVersionConfig mvc
JOIN #tmp_appType tat
     ON mvc.appType = tat.appType
JOIN #ticker tk
     ON mvc.tickerName = tk.tickerName
;
COMMIT;

-- MiLevel Clean-up
DROP TABLE IF EXISTS #MILevel;
SELECT
	lh.loanseqnum,
	min(lh.asOf) as first_asof,
	CAST(NULL as int) as pctMtgIns
INTO #MILevel
FROM scale.fhl_loanhist lh
JOIN scale.fhl_loan_dev sl ON lh.loanseqnum=sl.loanseqnum
WHERE sl.version in (select originationVersion from #tmp_version)
GROUP BY lh.loanseqnum;
COMMIT;

UPDATE #MILevel m SET m.pctMtgIns=lh.pctMtgIns
FROM scale.fhl_loanhist lh WHERE m.loanseqnum=lh.loanseqnum AND m.first_asof=lh.asof;
COMMIT;

--Calculate miLevel
UPDATE scale.fhl_loan_dev sl SET sl.miLevel=NULL WHERE sl.version in (select originationVersion from #tmp_version);
COMMIT;

UPDATE scale.fhl_loan_dev sl SET sl.miLevel=(CASE WHEN m.pctMtgIns IS NOT NULL AND m.pctMtgIns > 0 THEN m.pctMtgIns ELSE 0.0 END)
FROM #MILevel m WHERE sl.loanseqnum=m.loanseqnum AND sl.version in (select originationVersion from #tmp_version);
COMMIT;

UPDATE scale.fhl_loan_dev sl SET sl.miLevel=0.0 WHERE sl.miLevel is NULL and sl.version in (select originationVersion from #tmp_version);
COMMIT;

-- Deal with outliers
DROP TABLE IF EXISTS #mi_temp;
select d.loanSeqNum, d.miLevel
into #mi_temp
from scale.fhl_loan_dev d
where originationDate >= '20090701'
and d.version in (select originationVersion from #tmp_version);
COMMIT;

DROP TABLE IF EXISTS #tempMaxCov;
select t.loanSeqNum, cov = max(h.pctMtgIns)
into #tempMaxCov
from #mi_temp t,  fhl.cello_loanHist h, fhl.cello_loan l
where t.loanSeqNum = h.loanSeqNum
and t.loanSeqNum = l.loanSeqNum
and t.miLevel = 0
and h.pctMtgIns > 0
and h.schamBalance > 0.01
and l.origLTV > 80
group by t.loanSeqNum;
COMMIT;

update scale.fhl_loan_dev l set l.milevel=t.cov
from #tempMaxCov t where l.loanseqnum=t.loanseqnum and l.version in (select originationVersion from #tmp_version);
COMMIT;

-- Create Loan Origination Data
DROP TABLE IF EXISTS #FHL_OrigPMI;
SELECT
    cl.loanSeqNum ,
    cl.marketTicker,
    sl.originationDate,
    sl.origLoanSize,
    sl.origFICO,
    sl.origLTV,
    sl.miLevel,
    sl.percentHARPed,
    cl.occType as occupancyStatus,
    cl.loanPurposeType,
    cl.origTerm,
    
    cast(NULL as numeric(8, 4)) as pmi_begin_base,
    cast(NULL as numeric(8, 4)) as pmi_begin_occ,
    cast(NULL as numeric(8, 4)) as pmi_begin_size,
    cast(NULL as numeric(8, 4)) as pmi_begin
INTO #FHL_OrigPMI
FROM fhl.Cello_Loan cl
JOIN #ticker tk
    ON cl.marketTicker = tk.tickerName
JOIN scale.FHL_Loan_Dev sl
    ON cl.loanSeqNum = sl.loanSeqNum
WHERE 1=1
    AND sl.origLoanSize > 0.01
    AND sl.version in (select originationVersion from #tmp_version)
;

COMMIT;
CREATE HG INDEX loan_id_idx ON #FHL_OrigPMI(loanSeqNum);
CREATE LF INDEX ticker_idx ON #FHL_OrigPMI(marketTicker);
CREATE LF INDEX origination_date_idx ON #FHL_OrigPMI(originationDate);
CREATE HG INDEX bal_idx ON #FHL_OrigPMI(origLoanSize);
CREATE LF INDEX occ_idx ON #FHL_OrigPMI(occupancyStatus);
CREATE LF INDEX fico_idx ON #FHL_OrigPMI(origFICO);
CREATE LF INDEX ltv_idx ON #FHL_OrigPMI(origLTV);
COMMIT;


-- Update pmi_begin_base
UPDATE #FHL_OrigPMI inc SET inc.pmi_begin_base = pmi.PMI
FROM report.Cello_PMI_BASE pmi
WHERE 1=1
    AND pmi.LoanPurpose = CASE WHEN inc.loanPurposeType = 'PURCH' THEN 'PURCH' ELSE 'REFI' END
    AND inc.originationDate >= pmi.startDate and inc.originationDate < pmi.endDate 
    AND inc.origFICO >= pmi.FICObucketStart and inc.origFICO < pmi.FICObucketEnd
    AND inc.origLTV > pmi.LTVBucketStart and inc.origLTV <= pmi.LTVBucketEnd
	AND pmi.RateType = 'Fixed'
    AND inc.origTerm > pmi.TermBucketStart AND inc.origTerm <= pmi.TermBucketEnd
;
UPDATE #FHL_OrigPMI inc SET inc.pmi_begin_base = pmi.PMI
FROM report.Cello_PMI_BASE pmi
WHERE 1=1
    AND pmi.LoanPurpose = CASE WHEN inc.loanPurposeType = 'PURCH' THEN 'PURCH' ELSE 'REFI' END
    AND inc.originationDate >= pmi.startDate and inc.originationDate < pmi.endDate 
    AND pmi.FICObucketStart  <= 700 and   pmi.FICObucketEnd > 700
    AND inc.origLTV > pmi.LTVBucketStart and inc.origLTV <= pmi.LTVBucketEnd
	AND pmi.RateType = 'Fixed'
    AND inc.origTerm > pmi.TermBucketStart AND inc.origTerm <= pmi.TermBucketEnd
    AND inc.pmi_begin_base IS NULL
;
UPDATE #FHL_OrigPMI inc SET inc.pmi_begin_base = 0 WHERE inc.pmi_begin_base IS NULL;

-- Update pmi_begin_occ
UPDATE #FHL_OrigPMI inc SET inc.pmi_begin_occ = pmi.PMI
FROM report.Cello_PMI_Occupancy pmi
WHERE 1=1
    AND inc.occupancyStatus = pmi.OccType
    AND inc.originationDate >= pmi.startDate and inc.originationDate < pmi.endDate 
    AND inc.origFICO >= pmi.FICObucketStart and inc.origFICO < pmi.FICObucketEnd
    AND inc.origLTV > pmi.LTVBucketStart and inc.origLTV <= pmi.LTVBucketEnd
;
UPDATE #FHL_OrigPMI inc SET inc.pmi_begin_occ = pmi.PMI
FROM report.Cello_PMI_Occupancy pmi
WHERE 1=1
    AND inc.occupancyStatus = pmi.OccType
    AND inc.originationDate >= pmi.startDate and inc.originationDate < pmi.endDate 
    AND pmi.FICObucketStart <= 700 and   pmi.FICObucketEnd > 700
    AND inc.origLTV > pmi.LTVBucketStart and inc.origLTV <= pmi.LTVBucketEnd
    AND inc.pmi_begin_occ IS NULL
;
UPDATE #FHL_OrigPMI inc SET inc.pmi_begin_occ = 0 WHERE inc.pmi_begin_occ IS NULL;

-- Update pmi_begin_size
UPDATE #FHL_OrigPMI inc SET inc.pmi_begin_size = pmi.PMI
FROM report.Cello_PMI_LoanSize pmi
WHERE 1=1
    AND inc.origLoanSize > pmi.LoanSizeStart and inc.origLoanSize <= LoanSizeEnd
    AND inc.originationDate >= pmi.startDate and inc.originationDate < pmi.endDate 
    AND inc.origFICO >= pmi.FICObucketStart and inc.origFICO < pmi.FICObucketEnd
    AND inc.origLTV > pmi.LTVBucketStart and inc.origLTV <= pmi.LTVBucketEnd
;
UPDATE #FHL_OrigPMI inc SET inc.pmi_begin_size = pmi.PMI
FROM report.Cello_PMI_LoanSize pmi
WHERE 1=1
    AND inc.origLoanSize > pmi.LoanSizeStart and inc.origLoanSize <= LoanSizeEnd
    AND inc.originationDate >= pmi.startDate and inc.originationDate < pmi.endDate 
    AND pmi.FICObucketStart <= 700 and  pmi.FICObucketEnd > 700
    AND inc.origLTV > pmi.LTVBucketStart and inc.origLTV <= pmi.LTVBucketEnd
    AND inc.pmi_begin_size IS NULL
;
UPDATE #FHL_OrigPMI inc SET inc.pmi_begin_size = 0 WHERE inc.pmi_begin_size IS NULL;
COMMIT;

-- Update PMI
UPDATE #FHL_OrigPMI inc SET
pmi_begin = (CASE
                when miLevel > 0 then (pmi_begin_base + pmi_begin_occ + pmi_begin_size) / 100 
                else 0 
            END)
;

-- Update origPMI based on HARP Percent
UPDATE #FHL_OrigPMI
SET pmi_begin = CASE 
                        WHEN percentHARPed IS NULL THEN pmi_begin
                        WHEN percentHARPed = 0.0 THEN pmi_begin
                        WHEN percentHARPed = 100.0 THEN m.PMI
                    END
FROM report.Cello_PMI_HARP_MtgIns_Map m
WHERE 1=1
    AND miLevel > pctMtgInsLow
    AND miLevel <= pctMtgInsHigh
;
COMMIT;

-- Tests

