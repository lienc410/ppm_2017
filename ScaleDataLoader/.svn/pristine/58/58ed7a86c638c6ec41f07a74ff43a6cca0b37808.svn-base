-- Load Data into Scale Burnout Table

declare @count_previous int
   
    SELECT @count_previous = count(distinct(loanSeqNum))
    FROM scale.GNM_LoanBurnout
	
declare @count_current int
	 
	 SELECT @count_current = count(distinct(loanSeqNum))
	 FROM #GNM_LoanBurnout
	 
INSERT INTO scale.JobStatus (Job_Time, Job_Name, Job_Status, Previous_Loan_Count, Current_Loan_Count)
    SELECT
     getdate(),
    'GNM_Loan_Step 6_Create_Loan_Burnout_Table', 
    'SUCCESS', 
    @count_previous,
    @count_current
;
COMMIT;


DELETE FROM scale.GNM_LoanBurnout
FROM scale.GNM_LoanBurnout slb, #GNM_LoanBurnout lb
WHERE 1=1
    AND slb.loanSeqNum = lb.loanSeqNum
    AND slb.asOf = lb.asOf
    AND lb.marketTicker IN (SELECT tickerName FROM #ticker)
    AND slb.asOf >= (SELECT asOf from #tmp_asOf)
    AND slb.version in (SELECT burnoutVersion from #tmp_version)
;


INSERT INTO scale.GNM_LoanBurnout (loanSeqNum, asOf, version, burnout)
SELECT
    loanSeqNum,
    asOf,
    version,
    burnout
FROM #GNM_LoanBurnout
WHERE marketTicker IN (SELECT tickerName FROM #ticker)
    AND asOf >= (SELECT asOf from #tmp_asOf)
;