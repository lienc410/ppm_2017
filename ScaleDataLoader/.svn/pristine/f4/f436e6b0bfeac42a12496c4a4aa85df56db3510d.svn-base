--SELECT l.marketTicker, asOf, count(1), sum(balance), sum(balance * percentHARPed) / sum(balance) as wavg_pct_harped FROM scale.FNM_Loan l JOIN fnm.Cello_LoanHist lh ON l.loanSeqNum = lh.loanSeqNum GROUP BY l.marketTicker, asOf HAVING count(1) > 10 ORDER BY asOf

----------------------------------------------------------------------------------------------
-- Check to see if Loans have pctHARPed populated
----------------------------------------------------------------------------------------------
        declare   @cnt int
        SELECT
            @cnt =  count(1)
        FROM #FNM_regression WHERE pctHARPed IS NULL

        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of FNM Loans with NULL Value for percentage of HARPed: %1!', @cnt
            RETURN
        END
----------------------------------------------------------------------------------------------
-- Check to see if pctHARPed is in valid range
----------------------------------------------------------------------------------------------
        SELECT
            @cnt =  count(1)
        FROM
           #FNM_regression
        WHERE
            pctHARPed < 0.0 OR pctHARPed > 1

        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of FNM Loans with INVALID value for percentage of HARPed: %1!', @cnt
            RETURN
        END

-- End Tests



-- Update Scale Loan Table
-- Only update percentHARPed for NULL values
UPDATE scale.FNM_Loan_Dev l
SET l.percentHARPed = r.pctHARPed * 100.0
FROM #FNM_regression r
WHERE l.loanSeqNum = r.loanSeqNum
    AND l.marketTicker IN (SELECT tickerName FROM #ticker)
    AND l.version in (select originationVersion from #tmp_version)
    AND l.percentHARPed IS NULL
;

UPDATE scale.FNM_Loan_Dev 
SET percentHARPed = 0
WHERE 1=1
    AND marketTicker IN (SELECT tickerName FROM #ticker)
    AND version in (select originationVersion from #tmp_version)
	AND percentHARPed IS NULL;