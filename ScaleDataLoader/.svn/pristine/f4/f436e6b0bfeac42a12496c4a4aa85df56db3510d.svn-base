-- Fannie Conventional
-- Loan Level
-- Part 6 of 7
-- Script to update HARPed Percentage (Step 2)
-- Updates percentHARPed

-- Before execute the script, need to set the appType to run for
DROP TABLE IF EXISTS #tmp_appType;
SELECT '#####APPTYPE#####' AS appType INTO #tmp_appType
--SELECT '9.98' AS appType INTO #tmp_appType
;

-- Before execute the script, need to set the tickers
DROP TABLE IF EXISTS #ticker;
CREATE TABLE #ticker(
    tickerName varchar(20)
)
;
INSERT #ticker SELECT 'FNCL';   --Conventional Fannie
INSERT #ticker SELECT 'FNCK';     --Jumbo Fannie
INSERT #ticker SELECT 'FNCQ30';     --CQ Fannie High LTV[105-125]
INSERT #ticker SELECT 'FNCR';     --CR Fannie High LTV[125-150]
--INSERT #ticker SELECT 'FNCT';    --20 Yr Conventional Fannie
--INSERT #ticker SELECT 'FNCI';    --15 Yr Conventional Fannie
COMMIT;

CREATE LF INDEX loan_tickerName_idx ON #ticker(tickerName);
COMMIT;

-- Before execute the script, need to set the version to run for
DROP TABLE IF EXISTS #tmp_version;
SELECT mvc.tickerName, mvc.appType, mvc.incentiveVersion_LL as incentiveVersion, mvc.originationVersion_LL as originationVersion
INTO #tmp_version
FROM scale.ModelVersionConfig mvc
JOIN #tmp_appType tat
     ON mvc.appType = tat.appType
JOIN #ticker tk
     ON mvc.tickerName = tk.tickerName
;
COMMIT;

-----------------------------------------------------------------------
-- 1. Create index for HARP eligible percentage
--    HARP eligible ratio = (pre-HARP loans with incentive >= 50) / (all loans with incentive >= 50)
-----------------------------------------------------------------------    
DROP TABLE IF EXISTS #FNM_pctPreHARP;
SELECT 
    i.asOf,
	l.marketTicker,
    refinancible = sum(CASE WHEN i.conventional_refi_incentive >= 50.0 THEN clh.currentRpb ELSE 0.0 END),
    pre_refinancible = sum(CASE WHEN i.conventional_refi_incentive >= 50.0 AND l.originationDate <= '2009-06-01' THEN clh.currentRpb ELSE 0.0 END),
    pctPreHARP = CASE WHEN refinancible = 0.0 THEN 0.0 ELSE pre_refinancible / refinancible END
INTO #FNM_pctPreHARP
FROM scale.FNM_Loan_Dev l
JOIN
(
    SELECT loanSeqNum, asOf, currentRPB FROM fnm.Cello_LoanHist WHERE asOf >= '20140101'
    
    UNION ALL
    
    SELECT loanSeqNum, asOf, currentRPB FROM fnm.Cello_Derived_LoanHist
) clh
    ON l.loanSeqNum = clh.loanSeqNum
JOIN scale.FNM_LoanIncentive i
    ON clh.loanSeqNum = i.loanSeqNum
    AND clh.asOf = i.asOf
WHERE 1=1
    AND i.version in (select  incentiveVersion from #tmp_version)
    AND l.marketTicker in ('FNCL','FNCT','FNCI')
    AND l.version in (select originationVersion from #tmp_version)
GROUP BY i.asOf, l.marketTicker
;
COMMIT;


-- Use FHL data to estimate FNM between 2009-06-01 and 2014-01-01
DROP TABLE IF EXISTS #FHL_pctPreHARP;
SELECT 
    i.asOf,
    l.marketTicker,
    refinancible = sum(CASE WHEN i.conventional_refi_incentive >= 50.0 THEN clh.currentRpb ELSE 0.0 END),
    pre_refinancible = sum(CASE WHEN i.conventional_refi_incentive >= 50.0 AND l.originationDate <= '2009-06-01' AND i.asof >= '2009-06-01' THEN clh.currentRpb ELSE 0.0 END),
    pctPreHARP = CASE WHEN refinancible = 0.0 THEN 0.0 ELSE pre_refinancible / refinancible END
INTO #FHL_pctPreHARP
FROM scale.FHL_Loan_Dev l
JOIN fhl.Cello_LoanHist clh
    ON l.loanSeqNum = clh.loanSeqNum
JOIN scale.FHL_LoanIncentive i
    ON clh.loanSeqNum = i.loanSeqNum
    AND clh.asOf = i.asOf
WHERE 1=1
    AND i.version  IN (select  incentiveVersion from #tmp_version)
    AND l.version  IN (select  originationVersion from #tmp_version)
    AND l.marketTicker in ('FGLMC', 'FGTW', 'FGCI')
    AND i.asof >= '2009-06-01'
    AND i.asof < '2014-01-01'
GROUP BY i.asOf, l.marketTicker
;
COMMIT;


Update #FHL_pctPreHARP
SET marketticker='FNCL'
where marketticker='FGLMC';

Update #FHL_pctPreHARP
SET marketticker='FNCT'
where marketticker='FGTW';

Update #FHL_pctPreHARP
SET marketticker='FNCI'
where marketticker='FGCI';

Insert into #FNM_pctPreHARP
Select * from #FHL_pctPreHARP;
COMMIT;

-----------------------------------------------------------------------
-- 2. Create tmp table for monthly average and standard deviation 
--    Prepare for the z-score calculation
-----------------------------------------------------------------------  
-- Regression based on % diff of the monthly avg
DROP TABLE IF EXISTS #FNM_statistics;
SELECT
    sl.originationDate, 
	sl.marketTicker, 
    avg(sl.origFICO) as avg_FICO,
    avg(sl.origLTV) as avg_OLTV,
    avg(sl.origNoteRate) as avg_origNoteRate,
    avg(sl.origLoanSize) as avg_origLoanSize,
    stddev(sl.origFICO) as std_FICO,
    stddev(sl.origLTV) as std_OLTV,
    stddev(sl.origNoteRate) as std_origNoteRate,
    stddev(sl.origLoanSize) as std_origLoanSize
INTO #FNM_statistics
FROM fnm.Cello_Loan cl
JOIN scale.FNM_Loan_Dev sl
    ON cl.loanSeqNum = sl.loanSeqNum
WHERE sl.originationDate > '2009-06-01'
    AND sl.marketticker in ('FNCL','FNCT','FNCI')
    AND sl.origLTV <=80
    AND sl.origFICO > 300
    AND sl.origNoteRate > 0
    AND sl.origLoanSize > 0
    AND sl.origLTV > 0
    AND cl.loanpurposeType = 'RE-FI'
    AND sl.version IN (select originationVersion from #tmp_version)
    AND cl.coupon > 0
GROUP BY sl.originationDate, sl.marketTicker
;
COMMIT;

-----------------------------------------------------------------------
-- 3. Create percentHARPed estimate from regression
----------------------------------------------------------------------- 
DROP TABLE IF EXISTS #FNM_regression;
SELECT 
    loanseqNum,
    FICO_zs = (l.origFICO - s.avg_FICO) / s.std_FICO, 
    SATO_zs = (l.origNoteRate - avg_origNoteRate) / std_origNoteRate, 
    loanSize_zs = (l.origLoanSize - avg_origLoanSize) / std_origLoanSize,
    h.pctPreHARP,
    pctHARPed = exp(rg.Intercept + rg.cs * FICO_zs + rg.SATO * SATO_zs + rg.LoanSize * loanSize_zs + rg.RefiPct * 0.0 + rg.PreHARPPct * h.pctPreHARP) 
                / (1 + exp(rg.Intercept + rg.cs * FICO_zs + rg.SATO * SATO_zs + rg.LoanSize * loanSize_zs + rg.RefiPct * 0.0 + rg.PreHARPPct * h.pctPreHARP))
INTO #FNM_regression
FROM scale.FNM_Loan_Dev l
JOIN #FNM_statistics s
    ON l.originationDate = s.originationDate
	AND l.marketTicker = s.marketTicker
JOIN #FNM_pctPreHARP h
    ON l.originationDate = h.asOf
	AND l.marketTicker = s.marketTicker
, report.RegressionParameter_HARPIdentify rg
WHERE 1=1
    AND l.marketticker in ('FNCL','FNCT','FNCI')
    AND rg.status = 'ACTIVE'
    AND rg.Agency = 'FNM'
    AND l.version IN (select originationVersion from #tmp_version)
    AND l.percentHARPed IS NULL
;
COMMIT;



-- Tests

