-- Fannie Conventional
-- Loan Level
-- Part 2 of 7
-- Script to update HARPed Percentage (Step 1)
-- Updates percentHARPed


-- Before execute the script, need to set the appType to run for
DROP TABLE IF EXISTS #tmp_appType;
SELECT '#####APPTYPE#####' AS appType INTO #tmp_appType
--SELECT '9.98' AS appType INTO #tmp_appType
;

-- Before execute the script, need to set the dates to run for
DROP TABLE IF EXISTS #tmp_asOf;
SELECT 
CAST('#####ASOF#####' AS DATE) asOf, 
CAST('#####LAST#####' AS DATE) asOf_last,
CAST('2014-01-01' AS DATE) asOf_start
INTO #tmp_asOf
--SELECT CAST ('2018-06-01' AS DATE) asOf INTO #tmp_asOf
;

-- Before execute the script, need to set the tickers
DROP TABLE IF EXISTS #ticker;
CREATE TABLE #ticker(
    tickerName varchar(20)
)
;
INSERT #ticker SELECT 'FNCL';   --Conventional Fannie
INSERT #ticker SELECT 'FNCK';     --Jumbo Fannie
INSERT #ticker SELECT 'FNCQ30';     --CQ Fannie High LTV[105-125]
INSERT #ticker SELECT 'FNCR';     --CR Fannie High LTV[125-150]
--INSERT #ticker SELECT 'FNCT';    --20 Yr Conventional Fannie
--INSERT #ticker SELECT 'FNCI';    --15 Yr Conventional Fannie
COMMIT;

CREATE LF INDEX loan_tickerName_idx ON #ticker(tickerName);
COMMIT;

-- Before execute the script, need to set the version to run for
DROP TABLE IF EXISTS #tmp_version;
SELECT mvc.tickerName, mvc.appType, mvc.originationVersion_LL as originationVersion 
INTO #tmp_version
FROM scale.ModelVersionConfig mvc
JOIN #tmp_appType tat
     ON mvc.appType = tat.appType
JOIN #ticker tk
     ON mvc.tickerName = tk.tickerName
;
COMMIT;

-- Part ONE. Update percentHARPed
------------------------------------------------------
-- Assigning harp Pct of 100 for HARPed Loans
-- Assigning harp Pct of 0 for Non-HARPed Loans
-- NULL to Loans which are Unknown and have an MHA-ELIGIBLE Status
------------------------------------------------------
DROP TABLE IF EXISTS #FNM_HARPStatus;
SELECT
    loanSeqNum,
    marketTicker,
    CASE 
        WHEN ( ( HARPStatus = 'HARP')  OR  ( HARPStatus = 'Unknown' and MHAStatus = 'MHA-ELIGIBLE')) THEN 100.0
        WHEN ( HARPStatus IN ('< 2009-06', 'NON-HARP', 'N/A')) THEN 0.0
        ELSE NULL
    END as percentHARPed
INTO #FNM_HARPStatus
FROM fnm.Cello_Loan l
JOIN #ticker tk
    ON l.marketTicker = tk.tickerName
;

COMMIT;
CREATE HG INDEX loan_id_idx ON #FNM_HARPStatus(loanSeqNum);
CREATE LF INDEX ticker_idx ON #FNM_HARPStatus(marketTicker);
COMMIT;

-----------------------------------------------------------------------
-- Update Cello_Loan with percentHARPed for Jumbo and High-LTV
----------------------------------------------------------------------- 
UPDATE #FNM_HARPStatus l
SET percentHARPed = 0.0
WHERE marketTicker = 'FNCK'
;
UPDATE #FNM_HARPStatus l
SET percentHARPed = 100.0
WHERE marketTicker in ('FNCQ30','FNCR')
;
COMMIT;

-- Part TWO: Calculate MI-related

-- Part 1. clean pctMtgIns
-- Calculate MI
DROP TABLE IF EXISTS #FNM_MIClean;
SELECT
lh.loanseqnum,
lh.asof,
lh.currentRPB,
lh.pctMtgIns
INTO #FNM_MIClean
FROM 
(
	SELECT loanSeqNum, asOf, currentRpb, null as pctMtgins FROM fnm.Cello_Derived_LoanHist
    UNION ALL
    SELECT loanSeqNum, asOf, currentRpb, pctmtgins FROM fnm.Cello_LoanHist WHERE asOf >= '20140101'
)  lh 
WHERE  lh.asOf >= (select asOf_start from #tmp_asOf)
AND lh.asOf <= (select asOf_last from #tmp_asOf);
COMMIT;

-- set pctMtgIns to be NULL for paid-off loans
UPDATE #FNM_MIClean SET pctMtgIns=NULL WHERE currentRPB=0;
COMMIT;

-- Compare current month MI against previous month MI
DROP TABLE IF EXISTS #FNM_MIComparison;
SELECT 
    c.loanseqnum,
	c.asOf,
	c.pctMtgIns as CurrentMI,
	p.pctMtgIns as PreviousMI
INTO #FNM_MIComparison
FROM #FNM_MIClean c
JOIN  #FNM_MIClean p
ON c.loanseqnum = p.loanseqnum
AND c.asof = dateadd(month,1,p.asof);
COMMIT;

-- Forward-Clean-Up
-- Forward Fill if pctMtgIns changes from >=0 to NULL (use last available information)
DROP TABLE IF EXISTS #update_forward_null;
SELECT
    loanseqnum,
	asOf,
	CurrentMI,
	PreviousMI
INTO #update_forward_null
FROM #FNM_MIComparison
WHERE CurrentMI is NULL
AND PreviousMI >= 0;
COMMIT;

INSERT INTO scale.fnm_MI_update_list
SELECT * FROM #update_forward_null WHERE asOf=(select dateadd(month,-1,asOf_last) from #tmp_asOf);
COMMIT;

DELETE FROM scale.fnm_MI_update_list 
WHERE loanseqnum in (select loanseqnum from scale.fnm_loanhist where cltv<=0.01) and asOf=(select dateadd(month,-1,asOf_last
) from #tmp_asOf);
COMMIT;

UPDATE #FNM_MIClean mh SET mh.pctMtgIns=f.PreviousMI
FROM #update_forward_null f WHERE mh.loanseqnum=f.loanseqnum and mh.asOf>=f.asOf and mh.pctMtgIns is NULL;
COMMIT;

-- Pick up those loans with pctMtgIns changing from >0 to negative in history (MI is cancelled if pctMtgIns drops to -999)
DROP TABLE IF EXISTS #update_forward;
SELECT
    loanseqnum,
	asOf,
	CurrentMI,
	PreviousMI
INTO #update_forward
FROM #FNM_MIComparison
WHERE CurrentMI < 0
AND PreviousMI > 0;
COMMIT;

INSERT INTO scale.fnm_MI_update_list
SELECT * FROM #update_forward WHERE asOf=(select dateadd(month,-1,asOf_last) from #tmp_asOf);
COMMIT;

DELETE FROM scale.fnm_MI_update_list 
WHERE loanseqnum in (select loanseqnum from scale.fnm_loanhist where cltv<=0.01) and asOf=(select dateadd(month,-1,asOf_last
) from #tmp_asOf);
COMMIT;

UPDATE #FNM_MIClean mh SET mh.pctMtgIns=0
FROM #update_forward f WHERE mh.loanseqnum=f.loanseqnum and mh.asOf>=f.asOf and mh.pctMtgIns<0;
COMMIT;

-- Backward-Clean-Up
-- Pick up those loans with jumps in history (jumps from 0/NULL/negative to non-zero)
DROP TABLE IF EXISTS #update_history;
SELECT
    loanseqnum,
	asOf,
	CurrentMI,
	PreviousMI
INTO #update_history
FROM #FNM_MIComparison
WHERE (CurrentMI > 0 AND (PreviousMI <= 0 OR PreviousMI is NULL))
OR (CurrentMI > 0 AND PreviousMI > 0 AND CurrentMI>PreviousMI);
COMMIT;

INSERT INTO scale.fnm_MI_update_list
SELECT * FROM #update_history WHERE asOf=(select dateadd(month,-1,asOf_last) from #tmp_asOf);
COMMIT;

-- Find out jump time, use 2 jumps at most
drop table if exists #FNM_jump_summary;
select 
loanseqnum, 
min(asOf) as first_jump, 
NULL as first_currentMI, 
NULL as first_previousmi, 
case when max(asof) <> first_jump then max(asof) else NULL end as second_jump, 
NULL as second_currentMI, 
NULL as second_previousmi
into #FNM_jump_summary
from #update_history
group by loanseqnum;
commit;

update #FNM_jump_summary t set first_currentMI=currentMI,first_previousmi=previousmi
from #update_history h where t.loanseqnum=h.loanseqnum and t.first_jump=h.asof;
commit;

update #FNM_jump_summary t set second_currentMI=currentMI,second_previousmi=previousmi
from #update_history h where t.loanseqnum=h.loanseqnum and t.second_jump=h.asof;
commit;

-- clean up historical MI with jumps
update #FNM_MIClean h set h.pctMtgIns = t.first_currentMI
from #FNM_jump_summary t where ((h.pctMtgIns<=0) or (h.pctMtgIns is NULL) or (h.pctMtgIns>0 and h.pctMtgIns<t.first_currentMI)) and h.loanseqnum=t.loanseqnum and h.asOf<t.first_jump;
commit;

update #FNM_MIClean h set h.pctMtgIns = t.second_currentMI
from #FNM_jump_summary t where ((h.pctMtgIns<=0) or (h.pctMtgIns is NULL) or (h.pctMtgIns>0 and h.pctMtgIns<t.second_currentMI)) and h.loanseqnum=t.loanseqnum and h.asOf<t.second_jump and h.asOf>=t.first_jump;
commit;

-- Save cleaned pctMtgIns into prepay month table
DROP TABLE IF EXISTS #FNM_MIHist;
SELECT
lh.loanseqnum,
lh.asof,
lh.cltv,
l.origLTV,
cast (NULL as int) as pctMtgIns,
cast (NULL as varchar(10)) as actual_trigger,
cast (NULL as varchar(10)) as model_trigger,
cast (NULL as varchar(10)) as MICancelFlag_unlagged,
cast (NULL as varchar(10)) as MICancelFlag_lagged,
cast (NULL as int) as projected_month_unlagged,
cast (NULL as int) as projected_month_lagged
INTO #FNM_MIHist
FROM scale.fnm_loanhist lh
JOIN fnm.cello_loan l ON lh.loanseqnum=l.loanseqnum
WHERE lh.asOf >= (select asOf_start from #tmp_asOf)
AND lh.asOf <= (select asOf_last from #tmp_asOf)
AND l.origLTV>=80;
COMMIT;

UPDATE #FNM_MIHist mh SET mh.pctMtgIns=h.pctMtgIns
FROM #FNM_MIClean h WHERE mh.loanseqnum=h.loanseqnum and mh.asof=dateadd(month, -1, h.asof);
COMMIT;

-- For OLTV=80 loans, maximum possible pctMtgIns is 12, if pctMtgIns>12, we set it to 6
UPDATE #FNM_MIHist mh SET mh.pctMtgIns=6
WHERE mh.pctMtgIns>12 and origLTV=80;
COMMIT

UPDATE #FNM_MIHist SET pctMtgIns=NULL WHERE cltv<=0.01;
COMMIT;

-- Forward Clean Up for latest prepay month
DROP TABLE IF EXISTS #FNM_MIComparison_2;
SELECT 
    c.loanseqnum,
	c.asOf,
	c.pctMtgIns as CurrentMI,
	p.pctMtgIns as PreviousMI
INTO #FNM_MIComparison_2
FROM #FNM_MIHist c
JOIN  #FNM_MIHist p
ON c.loanseqnum = p.loanseqnum
AND c.asof = dateadd(month,1,p.asof)
WHERE CurrentMI is NULL
AND PreviousMI >= 0;
COMMIT;

-- SECOND-Forward-Clean-Up
UPDATE #FNM_MIHist mh SET mh.pctMtgIns=f.PreviousMI
FROM #update_forward f WHERE mh.loanseqnum=f.loanseqnum and mh.asOf>=f.asOf and (mh.pctMtgIns is NULL);
COMMIT;

-- Part 2. Fill up actual trigger with cleaned pctMtgIns
UPDATE #FNM_MIHist SET actual_trigger='Y' WHERE pctMtgIns=0;
COMMIT;

UPDATE #FNM_MIHist SET actual_trigger='N' WHERE actual_trigger is NULL;
COMMIT;

-- Part 3. for loans not eligible for Automatic Cancellation, always use actual data
DROP TABLE IF EXISTS #FNM_ELIGIBLE;
SELECT
l.loanseqnum,
cast(cast(l.calcorigmonth_ll*100+1 as char) as date) as origDate,
case when (l.numUnits < 0) then 1 else l.numUnits end as numUnits,
l.occType
INTO #FNM_ELIGIBLE
from fnm.cello_loan l
where l.occtype in ('OWNER','2ND','INV')
and l.numUnits>=1
and origDate >= '1999-08-01'
and loanseqnum in (select loanseqnum from #FNM_MIHist);
COMMIT;

DELETE FROM #FNM_ELIGIBLE WHERE occType='OWNER' and numUnits>4;
COMMIT;

DELETE FROM #FNM_ELIGIBLE WHERE occType='INV' and numUnits>4;
COMMIT;

-- for loans not eligible for Automatic Cancellation, model trigger is the same as actual trigger
UPDATE #FNM_MIHist h set model_trigger=actual_trigger
WHERE loanseqnum not in (select loanseqnum from #FNM_ELIGIBLE);
COMMIT;

-- for loans eligible for Automatic Cancellation, apply automatic cancellation rule
DROP TABLE IF EXISTS #FNM_MI_Model;
SELECT loanseqnum 
INTO #FNM_MI_Model
FROM #FNM_ELIGIBLE;
COMMIT;

DROP TABLE IF EXISTS #FNM_MI_Model_1;
SELECT loanseqnum 
INTO #FNM_MI_Model_1
FROM #FNM_ELIGIBLE
WHERE (occType='OWNER' and numUnits=1) or (occType='2ND');
COMMIT;

DROP TABLE IF EXISTS #FNM_MI_Model_2;
SELECT loanseqnum 
INTO #FNM_MI_Model_2
FROM #FNM_ELIGIBLE
WHERE (occType='OWNER' and numUnits>1) or (occType='INV');
COMMIT;

-- find out model cancellation time
DROP TABLE if EXISTS #FNM_Model_Cancel_1;
SELECT
h.loanseqnum,
h.asof,
cast(cast(l.calcorigmonth_ll*100+1 as char) as date) as origDate,
l.origTerm,
dateadd(month,origTerm/2,origDate) as midMonth,
case when (l.numUnits < 0) then 1 else l.numUnits end as numUnits,
l.occType,
h.currentRPB,
l.origLTV,
lh.cltv,
l.originalLoanAmount,
cast((CASE WHEN (l.origLTV IS NOT NULL and l.origLTV>0) THEN l.originalLoanAmount*100/l.origLTV ELSE NULL END) as numeric(14,2)) as appraised,
cast((CASE WHEN (l.origLTV IS NOT NULL and l.origLTV>0) THEN 0.78*l.originalLoanAmount*100/l.origLTV ELSE NULL END) as numeric(14,2)) as threshold,
cast(h.currentRPB/appraised as numeric(4,3)) as cltv_appraised
INTO #FNM_Model_Cancel_1
from fnm.cello_loan l
join 
(
	SELECT loanSeqNum, asOf, currentRpb FROM fnm.Cello_Derived_LoanHist
    UNION ALL
    SELECT loanSeqNum, asOf, currentRpb FROM fnm.Cello_LoanHist WHERE asOf >= '20140101'
)  h  
on l.loanseqnum=h.loanseqnum
join scale.fnm_loanhist lh on h.loanseqnum=lh.loanseqnum and h.asof=lh.asof
where h.currentRPB > 0
and (h.currentRPB <= threshold or h.asof>midMonth)
and h.loanseqnum in (select loanseqnum from #FNM_MI_Model_1);
COMMIT;

DROP table if exists #FNM_Model_Cancel_Time_1;
SELECT
loanseqnum,
min(asof) as first_asof
INTO #FNM_Model_Cancel_Time_1
FROM #FNM_Model_Cancel_1
GROUP BY loanseqnum;
COMMIT;

UPDATE #FNM_MIHist mh SET model_trigger='Y'
FROM #FNM_Model_Cancel_Time_1 c 
WHERE mh.loanseqnum=c.loanseqnum 
AND mh.asOf>=c.first_asOf
COMMIT;

UPDATE #FNM_MIHist mh SET model_trigger='N'
WHERE model_trigger is NULL
AND mh.loanseqnum in (SELECT loanseqnum from #FNM_MI_Model_1);
COMMIT;

DROP TABLE if EXISTS #FNM_Model_Cancel_2;
SELECT
h.loanseqnum,
h.asof,
cast(cast(l.calcorigmonth_ll*100+1 as char) as date) as origDate,
l.origTerm,
dateadd(month,origTerm/2,origDate) as midMonth,
l.numUnits,
l.occType,
h.currentRPB,
l.origLTV,
lh.cltv,
l.originalLoanAmount,
cast((CASE WHEN (l.origLTV IS NOT NULL and l.origLTV>0) THEN l.originalLoanAmount*100/l.origLTV ELSE NULL END) as numeric(14,2)) as appraised,
cast((CASE WHEN (l.origLTV IS NOT NULL and l.origLTV>0) THEN 0.78*l.originalLoanAmount*100/l.origLTV ELSE NULL END) as numeric(14,2)) as threshold,
cast(h.currentRPB/appraised as numeric(4,3)) as cltv_appraised
INTO #FNM_Model_Cancel_2
from fnm.cello_loan l
join 
(
	SELECT loanSeqNum, asOf, currentRpb FROM fnm.Cello_Derived_LoanHist
    UNION ALL
    SELECT loanSeqNum, asOf, currentRpb FROM fnm.Cello_LoanHist WHERE asOf >= '20140101'
)  h  
on l.loanseqnum=h.loanseqnum
join scale.fnm_loanhist lh on h.loanseqnum=lh.loanseqnum and h.asof=lh.asof
where h.currentRPB > 0
and h.asof>midMonth
and h.loanseqnum in (select loanseqnum from #FNM_MI_Model_2);
COMMIT;

DROP table if exists #FNM_Model_Cancel_Time_2;
SELECT
loanseqnum,
min(asof) as first_asof
INTO #FNM_Model_Cancel_Time_2
FROM #FNM_Model_Cancel_2
GROUP BY loanseqnum;
COMMIT;

UPDATE #FNM_MIHist mh SET model_trigger='Y'
FROM #FNM_Model_Cancel_Time_2 c 
WHERE mh.loanseqnum=c.loanseqnum 
AND mh.asOf>=c.first_asOf
COMMIT;

UPDATE #FNM_MIHist mh SET model_trigger='N'
WHERE model_trigger is NULL
AND mh.loanseqnum in (SELECT loanseqnum from #FNM_MI_Model_2);
COMMIT;

-- Part 4. Determine Lender-paid Loans
DROP TABLE IF EXISTS #Lender_1;
SELECT
h.loanseqnum,
h.asof,
cast(cast(l.calcorigmonth_ll*100+1 as char) as date) as origDate,
l.origTerm,
dateadd(month,origTerm/2,origDate) as midMonth,
case when (l.numUnits < 0) then 1 else l.numUnits end as numUnits,
l.occType,
h.currentRPB,
l.origLTV,
l.originalLoanAmount,
cast((CASE WHEN (l.origLTV IS NOT NULL AND l.origLTV>0) THEN 0.78*l.originalLoanAmount*100/l.origLTV ELSE NULL END) as numeric(14,2)) as appraised_value_threshold,
mh.pctMtgIns
INTO #Lender_1
from fnm.cello_loan l
join 
(
	SELECT loanSeqNum, asOf, currentRpb FROM fnm.Cello_Derived_LoanHist
    UNION ALL
    SELECT loanSeqNum, asOf, currentRpb FROM fnm.Cello_LoanHist WHERE asOf >= '20140101'
)  h 
on l.loanseqnum=h.loanseqnum
join #FNM_MIHist mh on l.loanseqnum=mh.loanseqnum and h.asof=mh.asof
where l.occtype in ('OWNER','2ND')
and l.origLTV > 80
and numUnits>=1
and origDate >= '1999-08-01'
and l.latestasOf >= '20170901'
and mh.pctMtgIns >= 0
and h.currentRPB > 0.01
and (h.currentRPB <= appraised_value_threshold or h.asof>midMonth)
and h.asOf<(select asof_last from #tmp_asOf);
COMMIT;

DELETE FROM #Lender_1 WHERE occType='OWNER' and numUnits>1;
COMMIT;

DROP TABLE if EXISTS #lender_paid_1;
SELECT distinct(loanseqnum) as loanseqnum into #lender_paid_1
from #Lender_1 where loanseqnum not in (select distinct(loanseqNum) from #Lender_1 where pctMtgIns = 0);
COMMIT;

DROP TABLE if EXISTS #Lender_2;
SELECT
h.loanseqnum,
h.asof,
cast(cast(l.calcorigmonth_ll*100+1 as char) as date) as origDate,
l.origTerm,
dateadd(month,origTerm/2,origDate) as midMonth,
case when (l.numUnits < 0) then 1 else l.numUnits end as numUnits,
l.occType,
h.currentRPB,
l.origLTV,
l.originalLoanAmount,
cast((CASE WHEN (l.origLTV IS NOT NULL AND l.origLTV>0) THEN 0.78*l.originalLoanAmount*100/l.origLTV ELSE NULL END) as numeric(14,2)) as appraised_value_threshold,
mh.pctMtgIns
INTO #Lender_2
from fnm.cello_loan l
join
(
	SELECT loanSeqNum, asOf, currentRpb FROM fnm.Cello_Derived_LoanHist
    UNION ALL
    SELECT loanSeqNum, asOf, currentRpb FROM fnm.Cello_LoanHist WHERE asOf >= '20140101'
)  h  
on l.loanseqnum=h.loanseqnum
join #FNM_MIHist mh on l.loanseqnum=mh.loanseqnum and h.asof=mh.asof
where l.occtype in ('OWNER','INV')
and l.origLTV > 80
and numUnits>=1
and origDate >= '1999-08-01'
and l.latestasOf >= '20170901'
and mh.pctMtgIns >= 0
and h.currentRPB > 0.01
and h.asof>midMonth;
COMMIT;

DELETE FROM #Lender_2 WHERE occType='OWNER' and numUnits=1;
COMMIT;

DELETE FROM #Lender_2 WHERE occType='INV' and numUnits>4;
COMMIT;

DROP TABLE if EXISTS #lender_paid_2;
SELECT distinct(loanseqnum) as loanseqnum into #lender_paid_2
from #Lender_2 where loanseqnum not in (select distinct(loanseqNum) from #Lender_2 where pctMtgIns = 0);
COMMIT;

--Save lender-paid MI loans into list table
DROP TABLE if EXISTS scale.fnm_lender_paid_previous;
SELECT * INTO scale.fnm_lender_paid_previous FROM scale.fnm_lender_paid;

DROP TABLE IF EXISTS scale.fnm_lender_paid;
SELECT 
loanseqnum,
CAST (NULL as date) as asOf
into scale.fnm_lender_paid from #lender_paid_1;
COMMIT;

INSERT INTO scale.fnm_lender_paid (loanseqnum) SELECT loanseqnum FROM #lender_paid_2;
COMMIT;

UPDATE scale.fnm_lender_paid p SET p.asOf=(select asOf_last from #tmp_asOf);
COMMIT;

-- Filter Haircut Loan
DROP TABLE IF EXISTS #last_record;
SELECT
loanseqnum, 
lastPrepaymonth=max(asof), 
cast (NULL as varchar(10)) as actual_trigger,
cast (NULL as varchar(10)) as model_trigger
into #last_record
from #FNM_MIHist 
where cltv>0.01
and asof< (select asof_last from #tmp_asOf)
group by loanseqnum;
commit;

update #last_record d set d.actual_trigger=c.actual_trigger, d.model_trigger=c.model_trigger
from #FNM_MIHIST c where d.loanseqnum=c.loanseqnum and d.lastprepaymonth=c.asof;
commit;

DROP TABLE IF EXISTS scale.fnm_mi_haircut_previous;
SELECT * INTO scale.fnm_mi_haircut_previous FROM scale.fnm_mi_haircut;

DROP TABLE IF EXISTS scale.fnm_mi_haircut;
SELECT 
loanseqnum,
cast (NULL as date) as asOf
INTO scale.fnm_mi_haircut
FROM #last_record d
WHERE d.actual_trigger='N'
AND d.model_trigger='N'
AND loanseqnum in (select loanseqnum from #FNM_ELIGIBLE);
COMMIT;

UPDATE scale.fnm_mi_haircut h SET h.asof=(select asof_last from #tmp_asOf);
COMMIT;

--Update the refresh Loans list.
--This will run only when updating Monthly data, not for changing any information in the past.(asof == asOf_last)
IF (SELECT asOf FROM #tmp_asOf) = (SELECT asOf_last FROM #tmp_asOf)
    BEGIN
	    DROP TABLE IF EXISTS #RefreshLoans
		
		SELECT distinct loanSeqNum INTO #RefreshLoans
		FROM scale.fnm_lender_paid_previous
		WHERE loanSeqNum not in (SELECT loanSeqNum FROM scale.fnm_lender_paid)
		
		INSERT INTO #RefreshLoans
		SELECT distinct loanSeqNum FROM scale.fnm_mi_haircut_previous
		WHERE loanSeqNum not in (SELECT loanSeqNum FROM scale.fnm_mi_haircut)
		
		DROP TABLE IF EXISTS scale.FNM_RefreshLoans
		SELECT distinct loanSeqNum INTO scale.FNM_RefreshLoans FROM #RefreshLoans
		GRANT SELECT ON scale.FNM_RefreshLoans TO PUBLIC
	END
;

-- Save Not Cancellable Flag in Scale Loan Table
UPDATE scale.fnm_loan_dev l SET Not_Cancellable_Flag=NULL
WHERE l.marketTicker IN (SELECT tickerName FROM #ticker) AND l.version in (SELECT originationVersion from #tmp_version);
COMMIT;

UPDATE scale.fnm_loan_dev l SET Not_Cancellable_Flag='Y'
WHERE loanseqnum in (SELECT loanseqnum from scale.fnm_lender_paid) 
AND version in (SELECT originationVersion from #tmp_version)
AND marketTicker IN (SELECT tickerName FROM #ticker)
;
COMMIT;

UPDATE scale.fnm_loan_dev l SET Not_Cancellable_Flag='NA'
WHERE loanseqnum in (SELECT loanseqnum from scale.fnm_mi_haircut) 
AND version in (SELECT originationVersion from #tmp_version)
AND marketTicker IN (SELECT tickerName FROM #ticker)
;
COMMIT;

UPDATE scale.fnm_loan_dev l SET Not_Cancellable_Flag='N'
WHERE Not_Cancellable_Flag is NULL 
AND version in (SELECT originationVersion from #tmp_version)
AND marketTicker IN (SELECT tickerName FROM #ticker)
;
COMMIT;


-- Part 5. Determine unlagged Flag
-- LENDER loans: always 'Y'
UPDATE #FNM_MIHist mh SET MICancelFlag_unlagged='Y'
WHERE loanseqnum in (SELECT loanseqnum from scale.fnm_lender_paid);
COMMIT;

-- NOT ELIGIBLE loans: always actual trigger
UPDATE #FNM_MIHist mh SET MICancelFlag_unlagged=actual_trigger
WHERE loanseqnum not in (select loanseqnum from #FNM_ELIGIBLE);
COMMIT;

-- ALL OTHER loans: use model/actual trigger
UPDATE #FNM_MIHist mh SET MICancelFlag_unlagged='Y'
WHERE MICancelFlag_unlagged is NULL AND (actual_trigger='Y' or model_trigger='Y');
COMMIT;

UPDATE #FNM_MIHist mh SET MICancelFlag_unlagged='N'
WHERE MICancelFlag_unlagged is NULL;
COMMIT;


-- Part 6. Determine lagged Flag
-- Filter Seasoned Loans
DROP TABLE if EXISTS #Seasoned;
SELECT
h.loanseqnum,
h.asof,
cast((CASE WHEN (l.origLTV IS NOT NULL AND l.origLTV>0) THEN l.originalLoanAmount*100/l.origLTV ELSE NULL END) as numeric(14,2)) as appraised,
cast(h.currentRPB/appraised as numeric(4,3)) as cltv_appraised
INTO #Seasoned
from fnm.cello_loan l
join 
(
	SELECT loanSeqNum, asOf, currentRpb FROM fnm.Cello_Derived_LoanHist
    UNION ALL
    SELECT loanSeqNum, asOf, currentRpb FROM fnm.Cello_LoanHist WHERE asOf >= '20140101'
)  h 
on l.loanseqnum=h.loanseqnum
join #FNM_MIHist lh on h.loanseqnum=lh.loanseqnum and h.asof=lh.asof;
COMMIT;

DROP TABLE if EXISTS #first_asof;
SELECT
loanseqnum,
min(asOf) as first_asof,
cast(NULL as numeric(4,3)) as cltv_appraised
INTO #first_asof
FROM #Seasoned
GROUP BY loanseqnum;
COMMIT;

UPDATE #first_asof f set f.cltv_appraised=s.cltv_appraised
FROM #Seasoned s WHERE f.loanseqnum=s.loanseqnum and f.first_asof=s.asof;
COMMIT;

DROP TABLE IF EXISTS #Lag;
SELECT
loanseqnum,
min(asof) as first_yes,
cast(NULL as int) as lag
into #Lag
FROM #FNM_MIHist
WHERE MICancelFlag_unlagged='Y'
GROUP BY loanseqnum;
COMMIT;

UPDATE #Lag l SET lag=0
FROM #first_asof f WHERE l.loanseqnum=f.loanseqnum and l.first_yes=f.first_asof and f.cltv_appraised<=0.70;
COMMIT;

UPDATE #Lag l SET lag=1
FROM #first_asof f WHERE l.loanseqnum=f.loanseqnum and l.first_yes=f.first_asof and f.cltv_appraised<=0.74 and l.lag is NULL;
COMMIT;

UPDATE #Lag l SET lag=2
WHERE lag is NULL;
COMMIT;

UPDATE #FNM_MIHist mh SET MICancelFlag_lagged='Y'
FROM #Lag l WHERE mh.loanseqnum=l.loanseqnum and mh.asof>=dateadd(month, l.lag, l.first_yes);
COMMIT;

UPDATE #FNM_MIHist mh SET MICancelFlag_lagged='Y'
WHERE loanseqnum in (SELECT loanseqnum from scale.fnm_lender_paid);
COMMIT;

UPDATE #FNM_MIHist mh SET MICancelFlag_lagged='N'
WHERE MICancelFlag_lagged is NULL;
COMMIT;

-- Part 7. Calculate unlagged/lagged projected_month
-- Load Input for MI Cancellation Projection
DROP TABLE IF EXISTS #Projected_MI_Cancel;
SELECT
l.loanseqnum,
lh.asOf,
l.origTerm,
(l.origTerm-lh.loanAge) as remain,
lh.remTerm as life,
l.occType,
case when (l.numUnits < 0) then 1 else l.numUnits end as numUnits,
cast(cast(l.calcorigmonth_ll*100+1 as char) as date) as origDate,
(1+l.origNoteRate/1200) as R,
case when lh.currentRPB<=0 Then 0.01 Else lh.currentRPB End as currentBalance,
cast((CASE WHEN (l.origLTV IS NOT NULL AND l.origLTV>0) THEN 0.78*l.originalLoanAmount*100/l.origLTV ELSE NULL END) as numeric(14,2)) as threshold,
cast((CASE WHEN (l.origLTV IS NOT NULL AND l.origLTV>0) THEN l.originalLoanAmount*100/l.origLTV ELSE NULL END) as numeric(14,2)) as appraised,
cast(NULL as numeric(30,15)) as factor,
mh.MICancelFlag_unlagged,
mh.projected_month_unlagged,
mh.projected_month_lagged
INTO #Projected_MI_Cancel
FROM fnm.cello_loan l
JOIN 
(
	SELECT loanSeqNum, asOf, currentRpb, remTerm, loanAge FROM fnm.Cello_Derived_LoanHist
    UNION ALL
    SELECT loanSeqNum, asOf, currentRpb, remTerm, loanAge FROM fnm.Cello_LoanHist WHERE asOf >= '20140101'
) lh
ON l.loanseqnum=lh.loanseqnum
JOIN #FNM_MIHist mh on lh.loanseqnum=mh.loanseqnum and lh.asof=mh.asof
WHERE l.loanseqnum in (select loanseqnum from #FNM_ELIGIBLE);
COMMIT;

DROP TABLE IF EXISTS #Category1;
SELECT
distinct(loanseqnum) as loanseqnum
INTO #Category1
FROM #Projected_MI_Cancel
WHERE (occType='OWNER' and numUnits=1) or (occType='2ND');
COMMIT;


-- Calculate Threshold factor
update #Projected_MI_Cancel set factor=CASE WHEN currentBalance>=threshold THEN (Power(R,life)-threshold*(Power(R,life)-1)/currentBalance) ELSE 1 END
WHERE loanseqnum in (select loanseqnum from #Category1);
COMMIT;

-- Calculate Projected month to MI cancellation 
update #Projected_MI_Cancel set projected_month_unlagged=CASE WHEN currentBalance>=threshold THEN (ceil(log(factor)/log(R))) ELSE 0 END
WHERE loanseqnum in (select loanseqnum from #Category1);
COMMIT;

-- Unlagged Project Month should be capped at midpoint of amortization
update #Projected_MI_Cancel set projected_month_unlagged=(remain-(origTerm/2)+1)
WHERE remain>=origTerm/2 and projected_month_unlagged>=(remain-(origTerm/2)+1);
COMMIT;

update #Projected_MI_Cancel set projected_month_unlagged=0
WHERE MICancelFlag_unlagged='Y' and projected_month_unlagged>0;
COMMIT;

update #Projected_MI_Cancel set projected_month_unlagged=(remain-(origTerm/2)+1)
WHERE remain>=origTerm/2 and projected_month_unlagged is NULL;
COMMIT;

update #Projected_MI_Cancel set projected_month_unlagged=0
WHERE remain<origTerm/2 and projected_month_unlagged is NULL;
COMMIT;

-- Calculate Lag, always 2-month lag unless seasoned
DROP TABLE IF EXISTS #month_lag;
SELECT
loanseqnum,
min(asOf) as first_0,
cast (NULL as int) as lag
INTO #month_lag
FROM #Projected_MI_Cancel
WHERE projected_month_unlagged=0
GROUP BY loanseqnum;
COMMIT;

UPDATE #month_lag l SET lag=0
FROM #first_asof f WHERE l.loanseqnum=f.loanseqnum and l.first_0=f.first_asof and f.cltv_appraised<=0.70;
COMMIT;

UPDATE #month_lag l SET lag=1
FROM #first_asof f WHERE l.loanseqnum=f.loanseqnum and l.first_0=f.first_asof and f.cltv_appraised<=0.74 and l.lag is NULL;
COMMIT;

UPDATE #month_lag l SET lag=2
WHERE lag is NULL;
COMMIT;

-- Calculate Lagged projected_month
UPDATE #Projected_MI_Cancel set projected_month_lagged=projected_month_unlagged;
COMMIT;

UPDATE #Projected_MI_Cancel set projected_month_lagged=projected_month_lagged + 2
WHERE projected_month_lagged > 0;
COMMIT;

UPDATE #Projected_MI_Cancel c set projected_month_lagged=projected_month_lagged + l.lag
FROM #month_lag l 
WHERE c.loanseqnum=l.loanseqnum and c.asof=l.first_0 and c.projected_month_lagged=0;
COMMIT;

UPDATE #Projected_MI_Cancel c set projected_month_lagged=projected_month_lagged + l.lag - 1
FROM #month_lag l 
WHERE c.loanseqnum=l.loanseqnum and c.asof=dateadd(month, 1, l.first_0) and c.projected_month_lagged=0 and l.lag>=1;
COMMIT;

-- Lagged Project Month should be capped at midpoint of amortization
update #Projected_MI_Cancel set projected_month_lagged=(remain-(origTerm/2)+3)
WHERE remain>=origTerm/2 and projected_month_lagged>=(remain-(origTerm/2)+3);
COMMIT;

update #Projected_MI_Cancel set projected_month_lagged=0
WHERE loanseqnum in (select loanseqnum from scale.fnm_lender_paid);
COMMIT;


-- Save data into #FNM_MIHist
update #FNM_MIHist mh SET mh.projected_month_unlagged=c.projected_month_unlagged, mh.projected_month_lagged=c.projected_month_lagged
FROM #Projected_MI_Cancel c WHERE mh.loanseqnum=c.loanseqnum AND mh.asof=c.asof;
COMMIT;

-- For loans not eligible for automatic cancellation, use wam as projected_month
update #FNM_MIHist mh set mh.projected_month_unlagged=h.remTerm, projected_month_lagged=h.remTerm
FROM
(
	SELECT loanSeqNum, asOf, remTerm FROM fnm.Cello_Derived_LoanHist
    UNION ALL
    SELECT loanSeqNum, asOf, remTerm FROM fnm.Cello_LoanHist WHERE asOf >= '20140101'
) h
WHERE mh.loanseqnum=h.loanseqnum AND mh.asof=h.asOf AND mh.projected_month_unlagged is NULL;
COMMIT;

update #FNM_MIHist set projected_month_unlagged=0, projected_month_lagged=0
WHERE MICancelFlag_unlagged='Y' and projected_month_unlagged>0 and loanseqnum not in (select loanseqnum from #Projected_MI_Cancel);
COMMIT;

DELETE FROM #FNM_MIHist WHERE projected_month_lagged is NULL;
COMMIT;

-- Tests
----------------------------------------------------------------------------------------------
-- Check to see if Loans have  NULL percentHARPed
----------------------------------------------------------------------------------------------
        declare   @cnt int
        SELECT
            @cnt =  count(1)
        FROM #FNM_HARPStatus  WHERE percentHARPed IS NULL and marketTicker in ( 'FNCK','FNCQ30','FNCR')

        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of FNM Jumbo/High LTV Loans with NULL VALUE for percentage of HARPed: %1!', @cnt
            RETURN
        END
----------------------------------------------------------------------------------------------
-- Check to see if percentHARPed is in valid range
----------------------------------------------------------------------------------------------
        SELECT
            @cnt =  count(1)
        FROM #FNM_HARPStatus  WHERE percentHARPed < 0.0 OR percentHARPed > 100

        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of FNM Loans with INVALID VALUE for percentage of HARPed: %1!', @cnt
            RETURN
        END
----------------------------------------------------------------------------------------------
-- Check to see if there are any NULL values
----------------------------------------------------------------------------------------------
        SELECT
            @cnt =  count(distinct(loanseqnum))
        FROM #FNM_LoanHist WHERE MICancelFlag_lagged is NULL

        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of FNM Loans with NULL Value for MICancelFlag: %1!', @cnt
           RETURN
       END   
----------------------------------------------------------------------------------------------
-- Check to see if burnout is in valid range
----------------------------------------------------------------------------------------------
        SELECT
            @cnt =  count(1)
        FROM
            #FNM_MIHist
        WHERE projected_month_lagged is NULL
		
        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of FNM Loans with NULL Value for Projected MI Cancellation Month: %1!', @cnt
            RETURN
        END
-- End Tests


-- Update Scale Loan Table
UPDATE scale.FNM_Loan_Dev
SET percentHARPed = NULL
WHERE marketTicker IN (SELECT tickerName FROM #ticker)
    AND version in (select originationVersion from #tmp_version)
;

UPDATE scale.FNM_Loan_Dev l
SET l.percentHARPed = hs.percentHARPed
FROM #FNM_HARPStatus hs
WHERE hs.marketTicker IN (SELECT tickerName FROM #ticker)
    AND l.loanSeqNum = hs.loanSeqNum
    AND l.version in (select originationVersion from #tmp_version)
;

UPDATE scale.fnm_loan_dev l SET Not_Cancellable_Flag=NULL
WHERE l.marketTicker IN (SELECT tickerName FROM #ticker) 
AND l.version in (SELECT originationVersion from #tmp_version);
COMMIT;

UPDATE scale.fnm_loan_dev l SET Not_Cancellable_Flag='Y'
WHERE loanseqnum in (SELECT loanseqnum from scale.fnm_lender_paid) 
AND version in (SELECT originationVersion from #tmp_version)
AND marketTicker IN (SELECT tickerName FROM #ticker)
;
COMMIT;

UPDATE scale.fnm_loan_dev l SET Not_Cancellable_Flag='NA'
WHERE loanseqnum in (SELECT loanseqnum from scale.fnm_mi_haircut) 
AND version in (SELECT originationVersion from #tmp_version)
AND marketTicker IN (SELECT tickerName FROM #ticker)
;
COMMIT;

UPDATE scale.fnm_loan_dev l SET Not_Cancellable_Flag='N'
WHERE Not_Cancellable_Flag is NULL 
AND version in (SELECT originationVersion from #tmp_version)
AND marketTicker IN (SELECT tickerName FROM #ticker)
;
COMMIT;

-- Update Scale LoanHist Table
update scale.fnm_loanhist lh 
SET 
lh.pctMtgIns=NULL, 
lh.actual_trigger=NULL, 
lh.model_trigger=NULL, 
lh.MICancelFlag_unlagged=NULL,
lh.MICancelFlag_lagged=NULL,
lh.projected_month_unlagged=NULL,
lh.projected_month_lagged=NULL
WHERE lh.asOf >= (select asOf_start from #tmp_asOf)
AND lh.asOf <= (select asOf_last from #tmp_asOf);
COMMIT;

update scale.fnm_loanhist lh 
SET 
lh.pctMtgIns=mh.pctMtgIns, 
lh.actual_trigger=mh.actual_trigger, 
lh.model_trigger=mh.model_trigger, 
lh.MICancelFlag_unlagged=mh.MICancelFlag_unlagged,
lh.MICancelFlag_lagged=mh.MICancelFlag_lagged,
lh.projected_month_unlagged=mh.projected_month_unlagged,
lh.projected_month_lagged=mh.projected_month_lagged
FROM #FNM_MIHist mh
WHERE lh.loanseqnum=mh.loanseqnum 
AND lh.asof=mh.asof
AND lh.asOf >= (select asOf_start from #tmp_asOf)
AND lh.asOf <= (select asOf_last from #tmp_asOf);
COMMIT;

update scale.fnm_loanhist lh 
SET 
lh.pctMtgIns=0,
lh.actual_trigger='N', 
lh.model_trigger='N', 
lh.MICancelFlag_unlagged='N',
lh.MICancelFlag_lagged='N',
lh.projected_month_unlagged=0, 
lh.projected_month_lagged=0
WHERE lh.loanseqnum not in (select loanseqnum from #FNM_MIHist)
AND lh.asOf >= (select asOf_start from #tmp_asOf)
AND lh.asOf <= (select asOf_last from #tmp_asOf);
COMMIT;


update scale.fnm_loanhist lh 
SET 
lh.pctMtgIns=NULL, 
lh.actual_trigger=NULL, 
lh.model_trigger=NULL,  
lh.MICancelFlag_unlagged=NULL,
lh.MICancelFlag_lagged=NULL,
lh.projected_month_unlagged=NULL,
lh.projected_month_lagged=NULL
WHERE cltv<=0.01
AND lh.asOf >= (select asOf_start from #tmp_asOf)
AND lh.asOf <= (select asOf_last from #tmp_asOf);
COMMIT;
