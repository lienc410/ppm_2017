-- Freddie Conventional
-- Pool Level
-- Part 2 of 6
-- Script to update distribution data
-- Updates Occupancy, Purpose, Delinquency, Channel, HARPed

-- Before execute the script, need to set the dates to run for
DROP TABLE IF EXISTS #tmp_asOf;
SELECT CAST('#####ASOF#####' AS DATE) asOf INTO #tmp_asOf
--SELECT CAST ('1994-02-01' AS DATE) asOf INTO #tmp_asOf
;
-- Before execute the script, need to set the version to run for
DROP TABLE IF EXISTS #tmp_version;
SELECT CAST ('2.50' AS varchar(5)) version INTO #tmp_version
;
-- Before execute the script, need to set the tickers
DROP TABLE IF EXISTS #ticker;
CREATE TABLE #ticker(
    tickerName varchar(20),
    mtgRateSeries varchar(30)
)
;
INSERT #ticker SELECT 'FGLMC', 'CONVENTIONAL_30YR';   --Conventional Freddie
INSERT #ticker SELECT 'FGT6', 'JUMBO_30YR';           --Jumbo Freddie
INSERT #ticker SELECT 'FGU6', 'CONVENTIONAL_30YR';    --CQ Freddie High LTV[105-125]
INSERT #ticker SELECT 'FGU9', 'CONVENTIONAL_30YR';    --CR Freddie High LTV[125-150]
COMMIT;

CREATE LF INDEX loan_tickerName_idx ON #ticker(tickerName);
COMMIT;


-- Create Pool Historical Data
DROP TABLE IF EXISTS #FHL_PoolDistribution;
SELECT
    ph.marketTicker,
    ph.issueId,
    ph.originationDate,
    ph.asOf,
    ph.balance,
    cast(NULL as numeric(6, 3)) as Pct_HARPed,
    cast(NULL as numeric(6, 3)) as Pct_MtgIns,
    cast(NULL as numeric(6, 3)) as Pct_OWNER,
    cast(NULL as numeric(6, 3)) as Pct_2ND,
    cast(NULL as numeric(6, 3)) as Pct_INV,
    cast(NULL as numeric(6, 3)) as Pct_PURCH,
    cast(NULL as numeric(6, 3)) as Pct_REFI,
    cast(NULL as numeric(6, 3)) as Pct_CURRENT,
    cast(NULL as numeric(6, 3)) as Pct_DELQ30p,
    cast(NULL as numeric(6, 3)) as Pct_DELQ60p,
    cast(NULL as numeric(6, 3)) as Pct_DELQ90p,
    cast(NULL as numeric(6, 3)) as Pct_RETAIL,
    cast(NULL as numeric(6, 3)) as Pct_BROKER,
    cast(NULL as numeric(6, 3)) as Pct_CORRES,
    cast(NULL as numeric(6, 3)) as Pct_SINGLE_UNIT,
    cast(NULL as numeric(6, 3)) as Pct_MULTIPLE_UNIT
INTO #FHL_PoolDistribution
FROM scale.FHL_PoolHist ph
JOIN #ticker tk
    ON ph.marketTicker = tk.tickerName
WHERE 1=1
    AND ph.asOf >= (select dateadd(month, -12, asOf) as asOf from #tmp_asOf)
;
COMMIT;

CREATE HG INDEX issueId_idx ON #FHL_PoolDistribution(issueId);
CREATE LF INDEX asOf_idx ON #FHL_PoolDistribution(asOf);
CREATE LF INDEX ticker_idx ON #FHL_PoolDistribution(marketTicker);
COMMIT;


-- Percent HARPed
DROP TABLE IF EXISTS #FHL_Pct_HARP;
SELECT
    pd.issueID,
    pd.asOf,
    CASE 
        WHEN sum(clh.currentRPB) = 0 THEN 0.0 
        ELSE sum(CASE WHEN sl.percentHARPed IS NULL THEN 0.0 ELSE sl.percentHARPed END * clh.currentRPB) / sum(clh.currentRPB) 
    END as pctHARPed
INTO #FHL_Pct_HARP
FROM #FHL_PoolDistribution pd
JOIN fhl.Cello_Loan cl
    ON pd.issueId = cl.issueId
JOIN scale.FHL_Loan_DEV sl
    ON cl.loanSeqNum = sl.loanSeqNum
JOIN fhl.Cello_LoanHist clh
    ON cl.loanseqNum = clh.loanSeqNum
    AND pd.asOf = clh.asOf
WHERE 1=1
AND version = (select version from #tmp_version)
GROUP BY pd.issueID, pd.asOf
;
COMMIT;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_HARPed = ph.pctHARPed
FROM #FHL_Pct_HARP ph
WHERE perf.issueId = ph.issueId
AND perf.asof = ph.asof
;
COMMIT;

UPDATE #FHL_PoolDistribution SET Pct_HARPed = 0.0 WHERE asOf < '2009-06-01' AND Pct_HARPed IS NULL;
COMMIT;

UPDATE #FHL_PoolDistribution SET Pct_HARPed = 0.0 WHERE originationDate < '2009-06-01' AND Pct_HARPed IS NULL;
COMMIT;

UPDATE #FHL_PoolDistribution SET Pct_HARPed = 0.0 WHERE Pct_HARPed IS NULL;
COMMIT;

-- Percent Mortgage Insurance
DROP TABLE IF EXISTS #FHL_MI_Dist;
SELECT
    p.marketTicker,
    p.issueId,
    p.asOf,
    percentRpb as Pct_MtgIns
INTO #FHL_MI_Dist
FROM #FHL_PoolDistribution p
LEFT JOIN fhl.Cello_LoanDist d
    ON p.issueId = d.issueId
    AND p.asof = d.asOf
    AND distributionName = 'MTGINS'
    AND distributionType = 'MTGINS'
    AND subType = 'Y'
;
COMMIT;

CREATE HG INDEX issueId_idx ON #FHL_MI_Dist(issueId);
CREATE LF INDEX asOf_idx ON #FHL_MI_Dist(asOf);
COMMIT;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_MtgIns = mi.Pct_MtgIns
FROM #FHL_MI_Dist mi
WHERE perf.issueId = mi.issueId 
    AND perf.asOf = mi.asOf
;
COMMIT;

DROP TABLE IF EXISTS #FHL_MinDate_MI;
SELECT
    marketTicker,
    issueId,
    min(asOf) as asOf,
    cast(NULL as numeric(12, 2)) as Pct_MtgIns
INTO #FHL_MinDate_MI
FROM #FHL_MI_Dist p
WHERE p.Pct_MtgIns IS NOT NULL 
GROUP BY marketTicker, issueId
;
COMMIT;

UPDATE #FHL_MinDate_MI s SET s.Pct_MtgIns = d.Pct_MtgIns
FROM #FHL_MI_Dist d
WHERE s.issueId = d.issueId
    AND s.asOf = d.asOf
;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_MtgIns = s.Pct_MtgIns
FROM #FHL_MinDate_MI s
WHERE perf.issueId = s.issueId 
    AND perf.Pct_MtgIns IS NULL
;

DROP TABLE IF EXISTS #FHL_OriginationDate_MI;
SELECT
    year(originationDate) as origYear,
    sum(balance * Pct_MtgIns) / sum(balance) as WAVG_MI,
    sum(balance) as sum_ls
INTO #FHL_OriginationDate_MI
FROM #FHL_PoolDistribution p
WHERE Pct_MtgIns IS NOT NULL
GROUP BY origYear
--HAVING sum_ls > 100000000
;
COMMIT;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_MtgIns = mi.WAVG_MI
FROM #FHL_OriginationDate_MI mi
WHERE year(perf.originationDate) = mi.origYear
    AND perf.Pct_MtgIns IS NULL
;

-- Occupancy Distribution
DROP TABLE IF EXISTS #FHL_Occ_Dist;
SELECT
    issueId,
    asOf,
    sum(Pct_OWNER) as Pct_OWNER,
    sum(Pct_2ND) as Pct_2ND,
    sum(Pct_INV) as Pct_INV,
    Pct_OWNER + Pct_2ND + Pct_INV as Pct_Total
INTO #FHL_Occ_Dist
FROM
(
SELECT
    p.issueId,
    p.asOf,
    CASE WHEN distributionType IN ('OWNER') THEN percentRpb ELSE 0.0 END as Pct_OWNER,
    CASE WHEN distributionType IN ('2ND','N/A') THEN percentRpb ELSE 0.0 END as Pct_2ND,
    CASE WHEN distributionType IN ('INV') THEN percentRpb ELSE 0.0 END as Pct_INV
FROM #FHL_PoolDistribution p
JOIN fhl.SecMaxAsOf s 
    ON p.issueID = s.issueID
    AND p.asOF = s.factorASOf
JOIN fhl.OccupancyDist occ
    ON p.issueId = occ.issueId
    AND s.occupancyAsOf = occ.asOf
WHERE p.asOf >= '2003-07-01'
) t
GROUP BY issueId, asOf
;
COMMIT;

CREATE HG INDEX issueId_idx ON #FHL_Occ_Dist(issueId);
CREATE LF INDEX asOf_idx ON #FHL_Occ_Dist(asOf);
COMMIT;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_OWNER = occ.Pct_OWNER, perf.Pct_2ND = occ.Pct_2ND, perf.Pct_INV = occ.Pct_INV
FROM #FHL_Occ_Dist occ
WHERE perf.issueId = occ.issueId 
    AND perf.asOf = occ.asOf
;
COMMIT;

DROP TABLE IF EXISTS #FHL_MinDate_OCC;
SELECT
    issueId,
    min(asOf) as asOf,
    cast(NULL as numeric(12, 2)) as Pct_OWNER,
    cast(NULL as numeric(12, 2)) as Pct_2ND,
    cast(NULL as numeric(12, 2)) as Pct_INV
INTO #FHL_MinDate_OCC
FROM #FHL_Occ_Dist p
WHERE p.Pct_OWNER IS NOT NULL 
GROUP BY issueId
;
COMMIT;

UPDATE #FHL_MinDate_OCC s SET s.Pct_OWNER = d.Pct_OWNER, s.Pct_2ND = d.Pct_2ND, s.Pct_INV = d.Pct_INV 
FROM #FHL_Occ_Dist d
WHERE s.issueId = d.issueId
    AND s.asOf = d.asOf
;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_OWNER = s.Pct_OWNER, perf.Pct_2ND = s.Pct_2ND, perf.Pct_INV = s.Pct_INV
FROM #FHL_MinDate_OCC s
WHERE perf.issueId = s.issueId 
    AND perf.Pct_OWNER IS NULL
;

DROP TABLE IF EXISTS #FHL_OriginationDate_OCC;
SELECT
    year(originationDate) as origYear,
    sum(balance * Pct_OWNER) / sum(balance) as WAVG_OWNER,
    sum(balance * Pct_2ND) / sum(balance) as WAVG_2ND,
    sum(balance * Pct_INV) / sum(balance) as WAVG_INV,
    sum(balance) as sum_ls
INTO #FHL_OriginationDate_OCC
FROM #FHL_PoolDistribution
WHERE Pct_OWNER IS NOT NULL
GROUP BY origYear
--HAVING sum_ls > 100000000
;
COMMIT;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_OWNER = occ.WAVG_OWNER, perf.Pct_2ND = occ.WAVG_2ND, perf.Pct_INV = occ.WAVG_INV
FROM #FHL_OriginationDate_OCC occ
WHERE year(perf.originationDate) = occ.origYear
    AND perf.Pct_OWNER IS NULL
;
COMMIT;

UPDATE #FHL_PoolDistribution SET Pct_OWNER = 100.0
WHERE Pct_OWNER > 100.0
;

UPDATE #FHL_PoolDistribution SET Pct_OWNER = 0.0
WHERE Pct_OWNER < 0.0
;

UPDATE #FHL_PoolDistribution SET Pct_2ND = Pct_2ND - ((Pct_OWNER + Pct_2ND + Pct_INV - 100.0) / 2.0), Pct_INV = Pct_INV - ((Pct_OWNER + Pct_2ND + Pct_INV - 100.0) / 2.0)
WHERE abs(Pct_OWNER + Pct_2ND + Pct_INV - 100.0) > 0.0
;

UPDATE #FHL_PoolDistribution SET Pct_OWNER = Pct_OWNER + Pct_2ND, Pct_2ND = 0.0
WHERE Pct_2ND < 0
;

UPDATE #FHL_PoolDistribution SET Pct_OWNER = Pct_OWNER + Pct_INV, Pct_INV = 0.0
WHERE Pct_INV < 0
;
COMMIT;

-- Loan Purpose Distribution
DROP TABLE IF EXISTS #FHL_Purpose_Dist;
SELECT
    issueId,
    asOf,
    sum(Pct_PURCH) as Pct_PURCH,
    sum(Pct_REFI) as Pct_REFI
INTO #FHL_Purpose_Dist
FROM
(
SELECT
    p.issueId,
    p.asOf,
    CASE WHEN distributionType IN ('PURCH') THEN percentRpb ELSE 0.0 END as Pct_PURCH,
    CASE WHEN distributionType IN ('RE-FI') THEN percentRpb ELSE 0.0 END as Pct_REFI
FROM #FHL_PoolDistribution p
JOIN fhl.Cello_LoanDist d
    ON p.issueId = d.issueId
    AND p.asof = d.asOf
    AND distributionName = 'LOANPURPOSE'
    AND subtype = 'ALL'
) t
GROUP BY issueId, asOf
;
COMMIT;

CREATE HG INDEX issueId_idx ON #FHL_Purpose_Dist(issueId);
CREATE LF INDEX asOf_idx ON #FHL_Purpose_Dist(asOf);
COMMIT;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_PURCH = purp.Pct_PURCH, perf.Pct_REFI = purp.Pct_REFI
FROM #FHL_Purpose_Dist purp
WHERE perf.issueId = purp.issueId 
    AND perf.asOf = purp.asOf
;
COMMIT;

DROP TABLE IF EXISTS #FHL_MinDate_PURP;
SELECT
    issueId,
    min(asOf) as asOf,
    cast(NULL as numeric(12, 2)) as Pct_PURCH,
    cast(NULL as numeric(12, 2)) as Pct_REFI
INTO #FHL_MinDate_PURP
FROM #FHL_Purpose_Dist p
WHERE p.Pct_PURCH IS NOT NULL AND p.Pct_REFI IS NOT NULL
GROUP BY issueId
;
COMMIT;

UPDATE #FHL_MinDate_PURP s SET s.Pct_PURCH = d.Pct_PURCH, s.Pct_REFI = d.Pct_REFI
FROM #FHL_Purpose_Dist d
WHERE s.issueId = d.issueId
    AND s.asOf = d.asOf
;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_PURCH = s.Pct_PURCH, perf.Pct_REFI = s.Pct_REFI
FROM #FHL_MinDate_PURP s
WHERE perf.issueId = s.issueId 
    AND (perf.Pct_PURCH IS NULL OR perf.Pct_REFI IS NULL)
;

DROP TABLE IF EXISTS #FHL_OriginationDate_PURP;
SELECT
    year(originationDate) as origYear,
    sum(balance * Pct_PURCH) / sum(balance) as WAVG_PURCH,
    sum(balance * Pct_REFI) / sum(balance) as WAVG_REFI,
    sum(balance) as sum_ls
INTO #FHL_OriginationDate_PURP
FROM #FHL_PoolDistribution
WHERE Pct_PURCH IS NOT NULL AND Pct_REFI IS NOT NULL
GROUP BY origYear
--HAVING sum_ls > 100000000
;
COMMIT;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_PURCH = purp.WAVG_PURCH, perf.Pct_REFI = purp.WAVG_REFI
FROM #FHL_OriginationDate_PURP purp
WHERE year(perf.originationDate) = purp.origYear
    AND (perf.Pct_PURCH IS NULL OR perf.Pct_REFI IS NULL)
;
COMMIT;

UPDATE #FHL_PoolDistribution SET Pct_PURCH = 100.0
WHERE Pct_PURCH > 100.0
;

UPDATE #FHL_PoolDistribution SET Pct_PURCH = 0.0
WHERE Pct_PURCH < 0.0
;

UPDATE #FHL_PoolDistribution SET Pct_REFI = 100.0
WHERE Pct_REFI > 100.0
;

UPDATE #FHL_PoolDistribution SET Pct_REFI = 0.0
WHERE Pct_REFI < 0.0
;

UPDATE #FHL_PoolDistribution SET Pct_PURCH = Pct_PURCH - ((Pct_PURCH + Pct_REFI - 100.0) / 2.0), Pct_REFI = Pct_REFI - ((Pct_PURCH + Pct_REFI - 100.0) / 2.0)
WHERE abs(Pct_PURCH + Pct_REFI - 100.0) > 0.0
;

-- Delinquency Distribution
DROP TABLE IF EXISTS #FHL_DELQ_Dist;
SELECT
    p.issueId,
    p.asOf,
    sum(CASE WHEN percentrpb_DEL30 = -999 THEN 0 ELSE IFNULL(percentrpb_DEL30, 0.0, percentrpb_DEL30) END) as Pct_DQ30,
    sum(CASE WHEN percentrpb_DEL60 = -999 THEN 0 ELSE IFNULL(percentrpb_DEL60, 0.0, percentrpb_DEL60) END) as Pct_DQ60,
    sum(CASE WHEN percentrpb_DEL90 = -999 THEN 0 ELSE IFNULL(percentrpb_DEL90, 0.0, percentrpb_DEL90) END) as Pct_DQ90,
    sum(CASE WHEN percentrpb_DEL120 = -999 THEN 0 ELSE IFNULL(percentrpb_DEL120, 0.0, percentrpb_DEL120) END) as Pct_DQ120
INTO #FHL_DELQ_Dist
FROM #FHL_PoolDistribution p
LEFT JOIN fhl.PivotedDelinqDist s 
    ON p.issueID = s.issueID
    AND p.asOF = s.asOf
GROUP BY p.issueId, p.asOf
;
COMMIT;

CREATE HG INDEX issueId_idx ON #FHL_DELQ_Dist(issueId);
CREATE LF INDEX asOf_idx ON #FHL_DELQ_Dist(asOf);
COMMIT;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_DELQ30p = dist.Pct_DQ30 + dist.Pct_DQ60 + dist.Pct_DQ90 + dist.Pct_DQ120, 
    perf.Pct_DELQ60p = dist.Pct_DQ60 + dist.Pct_DQ90 + dist.Pct_DQ120,
    perf.Pct_DELQ90p = dist.Pct_DQ90 + dist.Pct_DQ120
FROM #FHL_DELQ_Dist dist
WHERE perf.issueId = dist.issueId 
    AND perf.asOf = dist.asOf
;
UPDATE #FHL_PoolDistribution perf SET perf.Pct_CURRENT = 100.0 - perf.Pct_DELQ30p;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_CURRENT = 0.0 WHERE perf.Pct_CURRENT < 0;
UPDATE #FHL_PoolDistribution perf SET perf.Pct_DELQ30p = 0.0 WHERE perf.Pct_DELQ30p < 0;
UPDATE #FHL_PoolDistribution perf SET perf.Pct_DELQ60p = 0.0 WHERE perf.Pct_DELQ60p < 0;
UPDATE #FHL_PoolDistribution perf SET perf.Pct_DELQ90p = 0.0 WHERE perf.Pct_DELQ90p < 0;
UPDATE #FHL_PoolDistribution perf SET perf.Pct_CURRENT = 100.0 WHERE perf.Pct_CURRENT > 100;
UPDATE #FHL_PoolDistribution perf SET perf.Pct_DELQ30p = 100.0 WHERE perf.Pct_DELQ30p > 100;
UPDATE #FHL_PoolDistribution perf SET perf.Pct_DELQ60p = 100.0 WHERE perf.Pct_DELQ60p > 100;
UPDATE #FHL_PoolDistribution perf SET perf.Pct_DELQ90p = 100.0 WHERE perf.Pct_DELQ90p > 100;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_CURRENT = NULL, perf.Pct_DELQ30p = NULL, perf.Pct_DELQ60p = NULL, perf.Pct_DELQ90p = NULL
WHERE perf.asOf < '2011-01-01'
;
COMMIT;

-- Origination Channel Distribution
DROP TABLE IF EXISTS #FHL_Channel_Dist;
SELECT
    marketTicker,
    issueId,
    asOf,
    sum(Pct_RETAIL) as Pct_RETAIL,
    sum(Pct_BROKER) as Pct_BROKER,
    sum(Pct_CORRES) as Pct_CORRES,
    Pct_RETAIL + Pct_BROKER + Pct_CORRES as Pct_Total
INTO #FHL_Channel_Dist
FROM
(
SELECT
    p.marketTicker,
    p.issueId,
    p.asOf,
    CASE WHEN distributionType IN ('RETAIL') THEN percentRpb ELSE 0.0 END as Pct_RETAIL,
    CASE WHEN distributionType IN ('BROKER') THEN percentRpb ELSE 0.0 END as Pct_BROKER,
    CASE WHEN distributionType IN ('CORRES') THEN percentRpb ELSE 0.0 END as Pct_CORRES
FROM #FHL_PoolDistribution p
JOIN fhl.Cello_LoanDist d
    ON p.issueId = d.issueId
    AND p.asof = d.asOf
    AND distributionName = 'TPO'
    AND subtype = 'ALL'
WHERE 1=1
    AND originationDate >= '2008-08-01'
) t
GROUP BY marketTicker, issueId, asOf
;
COMMIT;

CREATE HG INDEX issueId_idx ON #FHL_Channel_Dist(issueId);
CREATE LF INDEX asOf_idx ON #FHL_Channel_Dist(asOf);
COMMIT;

UPDATE #FHL_Channel_Dist SET Pct_RETAIL = NULL, Pct_BROKER = NULL, Pct_CORRES = NULL WHERE abs(Pct_Total - 100.0) > 15.0;
COMMIT;

UPDATE #FHL_Channel_Dist SET Pct_RETAIL = NULL, Pct_BROKER = NULL, Pct_CORRES = NULL WHERE asOf <= '2008-10-01' AND marketTicker = 'FGT6';
COMMIT;

UPDATE #FHL_Channel_Dist SET Pct_RETAIL = NULL, Pct_BROKER = NULL, Pct_CORRES = NULL WHERE asOf <= '2010-01-01' AND marketTicker = 'FGU6';
COMMIT;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_RETAIL = ch.Pct_RETAIL, perf.Pct_BROKER = ch.Pct_BROKER, perf.Pct_CORRES = ch.Pct_CORRES
FROM #FHL_Channel_Dist ch
WHERE perf.issueId = ch.issueId 
    AND perf.asOf = ch.asOf
;
COMMIT;

DROP TABLE IF EXISTS #FHL_OriginationDate_CHAN;
SELECT
    marketTicker,
    year(originationDate) as origYear,
    sum(balance * Pct_RETAIL) / sum(balance) as WAVG_RETAIL,
    sum(balance * Pct_BROKER) / sum(balance) as WAVG_BROKER,
    sum(balance * Pct_CORRES) / sum(balance) as WAVG_CORRES,
    sum(balance) as sum_ls
INTO #FHL_OriginationDate_CHAN
FROM #FHL_PoolDistribution
WHERE Pct_RETAIL IS NOT NULL AND Pct_BROKER IS NOT NULL AND Pct_CORRES IS NOT NULL
GROUP BY marketTicker, origYear
--HAVING sum_ls > 100000000
;
COMMIT;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_RETAIL = chan.WAVG_RETAIL, perf.Pct_BROKER = chan.WAVG_BROKER, perf.Pct_CORRES = chan.WAVG_CORRES
FROM #FHL_OriginationDate_CHAN chan
WHERE 1=1
    AND year(perf.originationDate) = chan.origYear
    AND (perf.Pct_RETAIL IS NULL OR perf.Pct_BROKER IS NULL OR perf.Pct_CORRES IS NULL)
    AND perf.originationDate >= '2008-08-01'
    AND perf.marketTicker = chan.marketTicker
    AND perf.marketTicker = 'FGLMC';
;
COMMIT;

UPDATE #FHL_PoolDistribution SET Pct_RETAIL = 100.0
WHERE Pct_RETAIL > 100.0
;

UPDATE #FHL_PoolDistribution SET Pct_RETAIL = 0.0
WHERE Pct_RETAIL < 0.0
;

UPDATE #FHL_PoolDistribution SET Pct_BROKER = 100.0
WHERE Pct_BROKER > 100.0
;

UPDATE #FHL_PoolDistribution SET Pct_BROKER = 0.0
WHERE Pct_BROKER < 0.0
;

UPDATE #FHL_PoolDistribution SET Pct_CORRES = 100.0
WHERE Pct_CORRES > 100.0
;

UPDATE #FHL_PoolDistribution SET Pct_CORRES = 0.0
WHERE Pct_CORRES < 0.0
;
COMMIT;

-- Normalize to 100%
UPDATE #FHL_PoolDistribution SET Pct_RETAIL = Pct_RETAIL - ((Pct_RETAIL + Pct_BROKER + Pct_CORRES - 100.0) / 3.0), 
    Pct_BROKER = Pct_BROKER - ((Pct_RETAIL + Pct_BROKER + Pct_CORRES - 100.0) / 3.0), 
    Pct_CORRES = Pct_CORRES - ((Pct_RETAIL + Pct_BROKER + Pct_CORRES - 100.0) / 3.0)
WHERE abs(Pct_RETAIL + Pct_BROKER + Pct_CORRES - 100.0) > 0.01
;
COMMIT;


-- Number Units Distribution
DROP TABLE IF EXISTS #FHL_Unit_Dist;
SELECT
    issueId,
    asOf,
    sum(Pct_Single) as Pct_SINGLE_UNIT,
    sum(Pct_multiple) as Pct_MULTIPLE_UNIT
INTO #FHL_Unit_Dist
FROM
(
SELECT
    p.issueId,
    p.asOf,
    CASE WHEN distributionType IN ('1-UNIT') THEN percentRpb ELSE 0.0 END as Pct_Single,
    CASE WHEN distributionType IN ('2-4UN') THEN percentRpb ELSE 0.0 END as Pct_Multiple
FROM #FHL_PoolDistribution p
JOIN fhl.Cello_LoanDist d
    ON p.issueId = d.issueId
    AND p.asof = d.asOf
    AND distributionName = 'PROPERTY'
    AND subtype = 'ALL'
) t
GROUP BY issueId, asOf
;
COMMIT;

CREATE HG INDEX issueId_idx ON #FHL_Unit_Dist(issueId);
CREATE LF INDEX asOf_idx ON #FHL_Unit_Dist(asOf);
COMMIT;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_SINGLE_UNIT = un.Pct_SINGLE_UNIT, perf.Pct_MULTIPLE_UNIT = un.Pct_MULTIPLE_UNIT
FROM #FHL_Unit_Dist un
WHERE perf.issueId = un.issueId 
    AND perf.asOf = un.asOf
;
COMMIT;

DROP TABLE IF EXISTS #FHL_MinDate_UNIT;
SELECT
    issueId,
    min(asOf) as asOf,
    cast(NULL as numeric(12, 2)) as Pct_SINGLE_UNIT,
    cast(NULL as numeric(12, 2)) as Pct_MULTIPLE_UNIT
INTO #FHL_MinDate_UNIT
FROM #FHL_Unit_Dist p
WHERE p.Pct_SINGLE_UNIT IS NOT NULL AND p.Pct_MULTIPLE_UNIT IS NOT NULL
GROUP BY issueId
;
COMMIT;

UPDATE #FHL_MinDate_UNIT s SET s.Pct_SINGLE_UNIT = d.Pct_SINGLE_UNIT, s.Pct_MULTIPLE_UNIT = d.Pct_MULTIPLE_UNIT
FROM #FHL_Unit_Dist d
WHERE s.issueId = d.issueId
    AND s.asOf = d.asOf
;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_SINGLE_UNIT = s.Pct_SINGLE_UNIT, perf.Pct_MULTIPLE_UNIT = s.Pct_MULTIPLE_UNIT
FROM #FHL_MinDate_UNIT s
WHERE perf.issueId = s.issueId 
    AND (perf.Pct_SINGLE_UNIT IS NULL OR perf.Pct_MULTIPLE_UNIT IS NULL)
;

DROP TABLE IF EXISTS #FHL_OriginationDate_UNIT;
SELECT
    year(originationDate) as origYear,
    sum(balance * Pct_SINGLE_UNIT) / sum(balance) as WAVG_Single,
    sum(balance * Pct_MULTIPLE_UNIT) / sum(balance) as WAVG_Multiple,
    sum(balance) as sum_ls
INTO #FHL_OriginationDate_UNIT
FROM #FHL_PoolDistribution
WHERE Pct_SINGLE_UNIT IS NOT NULL AND Pct_MULTIPLE_UNIT IS NOT NULL
GROUP BY origYear
--HAVING sum_ls > 100000000
;
COMMIT;

UPDATE #FHL_PoolDistribution perf SET perf.Pct_SINGLE_UNIT = unit.WAVG_Single, perf.Pct_MULTIPLE_UNIT = unit.WAVG_Multiple
FROM #FHL_OriginationDate_UNIT unit
WHERE year(perf.originationDate) = unit.origYear
    AND (perf.Pct_SINGLE_UNIT IS NULL OR perf.Pct_MULTIPLE_UNIT IS NULL)
;
COMMIT;

UPDATE #FHL_PoolDistribution SET Pct_SINGLE_UNIT = 100.0
WHERE Pct_SINGLE_UNIT > 100.0
;

UPDATE #FHL_PoolDistribution SET Pct_SINGLE_UNIT = 0.0
WHERE Pct_SINGLE_UNIT < 0.0
;

UPDATE #FHL_PoolDistribution SET Pct_MULTIPLE_UNIT = 100.0
WHERE Pct_MULTIPLE_UNIT > 100.0
;

UPDATE #FHL_PoolDistribution SET Pct_MULTIPLE_UNIT = 0.0
WHERE Pct_MULTIPLE_UNIT < 0.0
;

UPDATE #FHL_PoolDistribution SET Pct_SINGLE_UNIT = 100.0 - Pct_MULTIPLE_UNIT
WHERE 1=1
    AND asOf IN ('2007-06-01', '2007-07-01', '2007-10-01')
    AND abs(Pct_SINGLE_UNIT + Pct_SINGLE_UNIT - 100.0) > 0.0
;
COMMIT;

UPDATE #FHL_PoolDistribution SET Pct_SINGLE_UNIT = Pct_SINGLE_UNIT - ((Pct_SINGLE_UNIT + Pct_MULTIPLE_UNIT - 100.0) / 2.0), Pct_MULTIPLE_UNIT = Pct_MULTIPLE_UNIT - ((Pct_SINGLE_UNIT + Pct_MULTIPLE_UNIT - 100.0) / 2.0)
WHERE abs(Pct_SINGLE_UNIT + Pct_MULTIPLE_UNIT - 100.0) > 0.0
;
COMMIT;



