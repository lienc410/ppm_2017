----------------------------------------------------------------------------------------------
-- Check to see if Pools have Pct_HARPed IS NULL OR Pct_HARPed < 0.0 OR Pct_HARPed > 100.0
----------------------------------------------------------------------------------------------
        declare   @cnt int
        SELECT
            @cnt =  count(1)
        FROM #FHL_PoolDistribution WHERE Pct_HARPed IS NULL OR Pct_HARPed < 0.0 OR Pct_HARPed > 100.0

        if (@cnt > 0)
        BEGIN
            RAISERROR 99999 'Number of FHL Pools with WRONG VALUE for percentage of HARPed: %1!', @cnt
            RETURN
        END

----------------------------------------------------------------------------------------------
