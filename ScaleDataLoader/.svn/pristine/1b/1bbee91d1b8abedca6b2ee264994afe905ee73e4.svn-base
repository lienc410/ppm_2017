                  Greetings:
                  <br/>
                  <br/>
                  Error found in the last row with asOf """ + asOf_n + """ Data not updated!
                  </body>"""
        em = EmailUtil.EmailUtil();
        em.sendMessage('john.xiong@cellocapital.com', "Error Found in Cre_Ava_Mdl_Check with File " + date_str, body);

