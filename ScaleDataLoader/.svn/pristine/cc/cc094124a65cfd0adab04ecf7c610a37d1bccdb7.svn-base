-- Fannie Conventional
-- Pool Level
-- Part 4 of 6
-- Script to update the eligibility metrics
-- Updates HARP_eligible, conventional_eligible and fha_eligible

-- Before execute the script, need to set the dates to run for
DROP TABLE IF EXISTS #tmp_asOf;
SELECT CAST('#####ASOF#####' AS DATE) asOf INTO #tmp_asOf
--SELECT CAST ('1994-02-01' AS DATE) asOf INTO #tmp_asOf
;
-- Before execute the script, need to set the version to run for
DROP TABLE IF EXISTS #tmp_version;
SELECT CAST ('2.50' AS varchar(5)) version INTO #tmp_version
;

-- Before execute the script, need to set the tickers
DROP TABLE IF EXISTS #ticker;
CREATE TABLE #ticker(
    tickerName varchar(20),
    mtgRateSeries varchar(30)
)
;
INSERT #ticker SELECT 'FNCL', 'CONVENTIONAL_30YR';    --Conventional Fannie
INSERT #ticker SELECT 'FNCK', 'JUMBO_30YR';           --Jumbo Fannie
INSERT #ticker SELECT 'FNCQ30', 'CONVENTIONAL_30YR';  --CQ Fannie High LTV[105-125]
INSERT #ticker SELECT 'FNCR', 'CONVENTIONAL_30YR';    --CR Fannie High LTV[125-150]
COMMIT;

CREATE LF INDEX loan_tickerName_idx ON #ticker(tickerName);
COMMIT;


-- Create Pool Historical Data
DROP TABLE IF EXISTS #FNM_PoolEligibility;
SELECT
    ph.marketTicker,
    ph.issueId,
    ph.asOf,
    ph.originationDate,
    cltvBucket = case
                    when ph.cltv < 10 THEN 10
                    when ph.cltv >= 140 THEN 150
                    else convert(int, ph.cltv / 10) * 10 + 10
                    end,
	ficoBucket = case 
                    when ph.origFICO < 500 THEN 500
                    when ph.origFICO >= 800 THEN 820
                    else convert(int, ph.origFICO / 20, 0) * 20 + 20
                    end,
    ph.balance,
    cast(NULL as numeric(6, 3)) as HARP_eligible,
    cast(NULL as numeric(6, 3)) as conventional_eligible,
    cast(NULL as numeric(6, 3)) as fha_eligible,
    cast(NULL as numeric(6, 3)) as refi_eligible
INTO #FNM_PoolEligibility
FROM scale.FNM_PoolHist ph
JOIN #ticker tk
    ON ph.marketTicker = tk.tickerName
WHERE 1=1
    AND ph.asOf >= (select asOf from #tmp_asOf)
;
COMMIT;

CREATE HG INDEX issueId_idx ON #FNM_PoolEligibility(issueId);
CREATE LF INDEX asOf_idx ON #FNM_PoolEligibility(asOf);
CREATE LF INDEX ticker_idx ON #FNM_PoolEligibility(marketTicker);
COMMIT;

-- Create HARP Eligibility from Loan Data
DROP TABLE IF EXISTS #FNM_Loan_HARPEligibility;
SELECT
    pe.issueId,
    pe.asOf,
    sum(sle.HARP_eligible * clh.balance) / sum(clh.balance) as HARP_eligible
INTO #FNM_Loan_HARPEligibility
FROM #FNM_PoolEligibility pe
JOIN fnm.Cello_Loan cl
    ON pe.issueId = cl.issueId
JOIN scale.fnm_LoanHist clh
    ON cl.loanSeqNum = clh.loanSeqNum
    AND pe.asOf = clh.asOf
JOIN scale.FNM_LoanEligibility sle
    ON clh.loanSeqNum = sle.loanSeqNum
    AND clh.asOf = sle.asOf
WHERE 1=1
    AND sle.HARP_eligible IS NOT NULL
GROUP BY pe.issueId, pe.asOf
;
COMMIT;

UPDATE #FNM_PoolEligibility pe SET pe.HARP_eligible = 100.0 * he.HARP_eligible
FROM #FNM_Loan_HARPEligibility he
WHERE pe.issueId = he.issueId
    AND pe.asOf = he.asOf
;

DROP TABLE IF EXISTS #FNM_MIN_HARPEligibility;
SELECT
    issueId,
    min(asOf) as min_asOf,
    cast(NULL as numeric(6, 3)) as earliest_HARP_eligible
INTO #FNM_MIN_HARPEligibility
FROM #FNM_PoolEligibility
WHERE 1=1
    AND HARP_eligible IS NOT NULL
    AND issueId in (SELECT distinct issueId from #FNM_Loan_HARPEligibility)
GROUP BY issueId
;
COMMIT;

UPDATE #FNM_MIN_HARPEligibility mhe SET mhe.earliest_HARP_eligible = pe.HARP_eligible
FROM #FNM_PoolEligibility pe
WHERE mhe.issueId = pe.issueId
    AND mhe.min_asOf = pe.asOf
;

UPDATE #FNM_PoolEligibility pe SET pe.HARP_eligible = mhe.earliest_HARP_eligible
FROM #FNM_MIN_HARPEligibility mhe
WHERE pe.issueId = mhe.issueId
    AND pe.HARP_eligible IS NULL
;
COMMIT;

-- Create HARP Eligibility from Pool Data
DROP TABLE IF EXISTS #FNM_Pool_HARPEligibility;
SELECT
    pe.issueId,
    pe.asOf,
    CASE
        WHEN pe.marketTicker in ('FNCQ30','FNCR') THEN 0.0
        WHEN pe.originationDate > '2009-06-01' THEN 0.0
        WHEN pe.asOf < '2009-06-01' THEN 0.0
        WHEN pe.asOf > '2017-09-01' THEN 0.0
        ELSE 1.0
    END as HARP_eligible
INTO #FNM_Pool_HARPEligibility
FROM #FNM_PoolEligibility pe
WHERE 1=1
    AND pe.HARP_eligible IS NULL
;
COMMIT;

UPDATE #FNM_PoolEligibility pe SET pe.HARP_eligible = 100.0 * he.HARP_eligible
FROM #FNM_Pool_HARPEligibility he
WHERE pe.issueId = he.issueId
    AND pe.asOf = he.asOf
;
COMMIT;


-- Create Conventional Eligibility from Loan Data
DROP TABLE IF EXISTS #FNM_Loan_ConventionalEligibility;
SELECT
    pe.issueId,
    pe.asOf,
    sum(sle.conventional_eligible * clh.balance) / sum(clh.balance) as conventional_eligible
INTO #FNM_Loan_ConventionalEligibility
FROM #FNM_PoolEligibility pe
JOIN fnm.Cello_Loan cl
    ON pe.issueId = cl.issueId
JOIN scale.fnm_LoanHist clh
    ON cl.loanSeqNum = clh.loanSeqNum
    AND pe.asOf = clh.asOf
JOIN scale.FNM_LoanEligibility sle
    ON clh.loanSeqNum = sle.loanSeqNum
    AND clh.asOf = sle.asOf
WHERE 1=1
    AND sle.conventional_eligible IS NOT NULL
GROUP BY pe.issueId, pe.asOf
;
COMMIT;

UPDATE #FNM_PoolEligibility pe SET pe.conventional_eligible = 100.0 * ce.conventional_eligible
FROM #FNM_Loan_ConventionalEligibility ce
WHERE pe.issueId = ce.issueId
    AND pe.asOf = ce.asOf
;
COMMIT;


-- Update Conventional Eligibility from Pool Data

  -- Step 1: Update OLTV Quartile to CLTV Quartile
DROP TABLE IF EXISTS #FNM_Pool_WACLTVquartile;
SELECT
    pe.issueId,
    pe.asOf,
    sph.origLTV,
    sph.cltv,
    cast(NULL as date) as min_asOf,
    q1Min,
    q1Max,
    q2Max,
    q3Max,
    q4Max
INTO #FNM_Pool_WACLTVquartile
FROM #FNM_PoolEligibility pe
JOIN scale.FNM_PoolHist sph
    ON pe.issueId = sph.issueId
    AND pe.asOf = sph.asOf
LEFT JOIN fnm.WAOLTVquartile qt
    ON sph.issueId = qt.issueId
    AND sph.asOf = qt.asOf
    AND qt.quartileType = 'OLTV'
    AND q4Max > 0.0
;

DROP TABLE IF EXISTS #FNM_MIN_WACLTVquartile;
SELECT
    issueId,
    min(asOf) as min_asOf,
    cast(NULL as numeric(8, 3)) as earliest_q1Min,
    cast(NULL as numeric(8, 3)) as earliest_q1Max,
    cast(NULL as numeric(8, 3)) as earliest_q2Max,
    cast(NULL as numeric(8, 3)) as earliest_q3Max,
    cast(NULL as numeric(8, 3)) as earliest_q4Max
INTO #FNM_MIN_WACLTVquartile
FROM #FNM_Pool_WACLTVquartile
WHERE q1Min IS NOT NULL
GROUP BY issueId
;

UPDATE #FNM_MIN_WACLTVquartile mqt SET
    mqt.earliest_q1Min = qt.q1Min,
    mqt.earliest_q1Max = qt.q1Max,
    mqt.earliest_q2Max = qt.q2Max,
    mqt.earliest_q3Max = qt.q3Max,
    mqt.earliest_q4Max = qt.q4Max
FROM #FNM_Pool_WACLTVquartile qt
WHERE mqt.issueId = qt.issueId
    AND mqt.min_asOf = qt.asOf
;

UPDATE #FNM_Pool_WACLTVquartile qt SET 
    qt.min_asOf = mqt.min_asOf,
    qt.q1Min = mqt.earliest_q1Min,
    qt.q1Max = mqt.earliest_q1Max,
    qt.q2Max = mqt.earliest_q2Max,
    qt.q3Max = mqt.earliest_q3Max,
    qt.q4Max = mqt.earliest_q4Max
FROM #FNM_MIN_WACLTVquartile mqt
WHERE qt.issueId = mqt.issueId
    AND qt.q1Min IS NULL
;

UPDATE #FNM_Pool_WACLTVquartile SET
    q1Min = CASE WHEN origLTV > 0.0 THEN (cltv / origLTV) * q1Min ELSE q1Min END,
    q1Max = CASE WHEN origLTV > 0.0 THEN (cltv / origLTV) * q1Max ELSE q1Max END,
    q2Max = CASE WHEN origLTV > 0.0 THEN (cltv / origLTV) * q2Max ELSE q2Max END,
    q3Max = CASE WHEN origLTV > 0.0 THEN (cltv / origLTV) * q3Max ELSE q3Max END,
    q4Max = CASE WHEN origLTV > 0.0 THEN (cltv / origLTV) * q4Max ELSE q4Max END
;
COMMIT;

DELETE FROM #FNM_Pool_WACLTVquartile
WHERE q4Max IS NULL;
COMMIT;

  -- Step 1b: Update FICO Quartile farther back in time
DROP TABLE IF EXISTS #FNM_Pool_WAFICOquartile;
SELECT
    pe.issueId,
    pe.asOf,
    sph.origFICO,
    wtdAvg as waocs,
    cast(NULL as date) as min_asOf,
    q1Min,
    q1Max,
    q2Max,
    q3Max,
    q4Max
INTO #FNM_Pool_WAFICOquartile
FROM #FNM_PoolEligibility pe
JOIN scale.FNM_PoolHist sph
    ON pe.issueId = sph.issueId
    AND pe.asOf = sph.asOf
LEFT JOIN fnm.WAOCSquartile qt
    ON sph.issueId = qt.issueId
    AND sph.asOf = qt.asOf
    AND qt.quartileType = 'OCS'
    AND q4Max > 0.0
;

DROP TABLE IF EXISTS #FNM_MIN_WAFICOquartile;
SELECT
    issueId,
    min(asOf) as min_asOf,
    cast(NULL as numeric(8, 3)) as earliest_waocs,
    cast(NULL as numeric(8, 3)) as earliest_q1Min,
    cast(NULL as numeric(8, 3)) as earliest_q1Max,
    cast(NULL as numeric(8, 3)) as earliest_q2Max,
    cast(NULL as numeric(8, 3)) as earliest_q3Max,
    cast(NULL as numeric(8, 3)) as earliest_q4Max
INTO #FNM_MIN_WAFICOquartile
FROM #FNM_Pool_WAFICOquartile
WHERE q1Min IS NOT NULL
GROUP BY issueId
;

UPDATE #FNM_MIN_WAFICOquartile mqt SET
    mqt.earliest_waocs = qt.waocs,
    mqt.earliest_q1Min = qt.q1Min,
    mqt.earliest_q1Max = qt.q1Max,
    mqt.earliest_q2Max = qt.q2Max,
    mqt.earliest_q3Max = qt.q3Max,
    mqt.earliest_q4Max = qt.q4Max
FROM #FNM_Pool_WAFICOquartile qt
WHERE mqt.issueId = qt.issueId
    AND mqt.min_asOf = qt.asOf
;

UPDATE #FNM_Pool_WAFICOquartile qt SET
    qt.min_asOf = mqt.min_asOf,
    qt.waocs = mqt.earliest_waocs,
    qt.q1Min = mqt.earliest_q1Min,
    qt.q1Max = mqt.earliest_q1Max,
    qt.q2Max = mqt.earliest_q2Max,
    qt.q3Max = mqt.earliest_q3Max,
    qt.q4Max = mqt.earliest_q4Max
FROM #FNM_MIN_WAFICOquartile mqt
WHERE qt.issueId = mqt.issueId
    AND qt.q1Min IS NULL
;

UPDATE #FNM_Pool_WAFICOquartile SET
    q1Min = CASE WHEN waocs > 0.0 THEN (origFICO / waocs) * q1Min ELSE q1Min END,
    q1Max = CASE WHEN waocs > 0.0 THEN (origFICO / waocs) * q1Max ELSE q1Max END,
    q2Max = CASE WHEN waocs > 0.0 THEN (origFICO / waocs) * q2Max ELSE q2Max END,
    q3Max = CASE WHEN waocs > 0.0 THEN (origFICO / waocs) * q3Max ELSE q3Max END,
    q4Max = CASE WHEN waocs > 0.0 THEN (origFICO / waocs) * q4Max ELSE q4Max END
WHERE asOf < min_asOf
;
COMMIT;

DELETE FROM #FNM_Pool_WAFICOquartile
WHERE q4Max IS NULL;
COMMIT;

  -- Step 2: Estimate Percent of Pool > 97 CLTV or < 620 FICO
DROP TABLE IF EXISTS #FNM_FICO_Eligible;
SELECT
    qf.issueId,
    qf.asOf,
    CASE 
        WHEN 620 <= q1Min THEN 0.0
        WHEN 620 <= q1Max THEN 0.0  + ((620.0 - q1Min)/(q1Max - q1Min)) * 25.0
        WHEN 620 <= q2Max THEN 25.0 + ((620.0 - q1Max)/(q2Max - q1Max)) * 25.0
        WHEN 620 <= q3Max THEN 50.0 + ((620.0 - q2Max)/(q3Max - q2Max)) * 25.0
        WHEN 620 <= q4Max THEN 75.0 + ((620.0 - q3Max)/(q4Max - q3Max)) * 25.0
        WHEN 620 > q4Max THEN 100.0
        ELSE NULL
    END as percent_not_eligible_fico,
    100.0 - percent_not_eligible_fico as percent_eligible_fico
INTO #FNM_FICO_Eligible
FROM #FNM_Pool_WAFICOquartile qf
JOIN #FNM_PoolEligibility pe
    ON qf.issueId = pe.issueId
    AND qf.asOf = pe.asOf
WHERE 1=1
    AND pe.conventional_eligible IS NULL
;

DROP TABLE IF EXISTS #FNM_CLTV_Eligible;
SELECT
    ql.issueId,
    ql.asOf,
    CASE 
        WHEN q4Max <= 97.0 THEN 100.0
        WHEN q3Max <= 97.0 THEN 75.0 + ((97.0-q3Max)/(q4Max-q3Max)) * 25.0
        WHEN q2Max <= 97.0 THEN 50.0 + ((97.0-q2Max)/(q3Max-q2Max)) * 25.0
        WHEN q1Max <= 97.0 THEN 25.0 + ((97.0-q1Max)/(q2Max-q1Max)) * 25.0
        WHEN q1Min <= 97.0 THEN 0.0  + ((97.0-q1Min)/(q1Max-q1Min)) * 25.0
        WHEN q1Min > 97.0 THEN 0.0
        ELSE NULL
    END as percent_eligible_ltv,
    100.0 - percent_eligible_ltv as percent_not_eligible_ltv
INTO #FNM_CLTV_Eligible
FROM #FNM_Pool_WACLTVquartile ql
JOIN #FNM_PoolEligibility pe
    ON ql.issueId = pe.issueId
    AND ql.asOf = pe.asOf
WHERE 1=1
    AND pe.conventional_eligible IS NULL
;

  -- Step 3: Combine FICO and CLTV percent not eligible
UPDATE #FNM_PoolEligibility pe SET pe.conventional_eligible = 100.0 - (IFNULL(percent_not_eligible_fico, 0.0, percent_not_eligible_fico) + percent_not_eligible_ltv - (100.0 * (IFNULL(percent_not_eligible_fico, 0.0, percent_not_eligible_fico) / 100.0) * (percent_not_eligible_ltv / 100.0)))
FROM #FNM_FICO_Eligible fe, #FNM_CLTV_Eligible ce
WHERE 1=1
    AND pe.issueId = fe.issueId
    AND pe.issueId = ce.issueId
    AND pe.asOf = fe.asOf
    AND pe.asOf = ce.asOf
    AND ce.percent_not_eligible_ltv IS NOT NULL
    AND pe.conventional_eligible IS NULL
;

UPDATE #FNM_PoolEligibility pe SET pe.conventional_eligible = CASE WHEN conventional_eligible > 100 THEN 100.0 WHEN conventional_eligible < 0.0 THEN 0.0 ELSE conventional_eligible END;
COMMIT;


  -- Step 4: Update Pools with no Eligibility Information based on FICO/CLTV buckets
DROP TABLE IF EXISTS #FNM_AsOf_ConvEligibleBuckets;
SELECT 
    --d.asOf,
    cltvBucket = case
                    when cltv < 10 THEN 10
                    when cltv >= 140 THEN 150
                    else convert(int, cltv / 10) * 10 + 10
                    end,
	ficoBucket = case 
                    when origFICO < 500 THEN 500
                    when origFICO >= 800 THEN 820
                    else convert(int, origFICO / 20) * 20 + 20
                    end,
    sum(d.conventional_eligible * h.balance) / sum(h.balance) as avg_conventional_eligible
INTO #FNM_AsOf_ConvEligibleBuckets
FROM #FNM_PoolEligibility d
JOIN scale.FNM_PoolHist h
    ON h.issueId = d.issueId
    AND h.asof = d.asof
WHERE 1=1
    AND conventional_eligible IS NOT NULL
GROUP BY cltvBucket, ficoBucket
ORDER BY cltvBucket, ficoBucket
;
COMMIT;


-- Update the HARPed Pct Estimates
UPDATE #FNM_PoolEligibility pd SET 
    pd.conventional_eligible = b.avg_conventional_eligible
FROM #FNM_AsOf_ConvEligibleBuckets b
WHERE 1 = 1
    AND pd.cltvBucket = b.cltvBucket
    AND pd.ficoBucket = b.ficoBucket
    AND pd.conventional_eligible IS NULL
;
COMMIT;

--  -- Step 5: Update Pools from 2013-01-01 to 2013-12-01
--UPDATE #FNM_PoolEligibility pd SET 
--    pd.conventional_eligible = b.avg_conventional_eligible
--FROM #FNM_AsOf_ConvEligibleBuckets b
--WHERE 1 = 1
--    AND pd.cltvBucket = b.cltvBucket
--    AND pd.ficoBucket = b.ficoBucket
--    AND pd.asOf >= '2013-01-01'
--    AND pd.asOf <= '2013-12-01'


UPDATE #FNM_PoolEligibility pe SET pe.conventional_eligible = t.wavg_conv_elig
FROM (SELECT avg(conventional_eligible) as wavg_conv_elig FROM #FNM_PoolEligibility WHERE year(originationDate) <= 1972) t
WHERE pe.conventional_eligible IS NULL
;
COMMIT;



-- Update FHA Eligibility from Loan Data
DROP TABLE IF EXISTS #FNM_Loan_FHAEligibility;
SELECT
    pe.issueId,
    pe.asOf,
    sum(sle.fha_eligible * clh.balance) / sum(clh.balance) as fha_eligible
INTO #FNM_Loan_FHAEligibility
FROM #FNM_PoolEligibility pe
JOIN fnm.Cello_Loan cl
    ON pe.issueId = cl.issueId
JOIN scale.fnm_LoanHist clh
    ON cl.loanSeqNum = clh.loanSeqNum
    AND pe.asOf = clh.asOf
JOIN scale.FNM_LoanEligibility sle
    ON clh.loanSeqNum = sle.loanSeqNum
    AND clh.asOf = sle.asOf
WHERE 1=1
    AND sle.fha_eligible IS NOT NULL
GROUP BY pe.issueId, pe.asOf
;
COMMIT;

UPDATE #FNM_PoolEligibility pe SET pe.fha_eligible = 100.0 * ce.fha_eligible
FROM #FNM_Loan_FHAEligibility ce
WHERE pe.issueId = ce.issueId
    AND pe.asOf = ce.asOf
;
COMMIT;


-- Update FHA Eligibility from Pool Data

    -- Step 1: Update FICO and OLTV Quartile
DROP TABLE IF EXISTS #FNM_FHA_FICO_Eligible;
SELECT
    qf.issueId,
    qf.asOf,
    CASE 
        WHEN 500 <= q1Min THEN 0.0
        WHEN 500 <= q1Max THEN 0.0  + ((500.0-q1Min)/(q1Max-q1Min)) * 25.0
        WHEN 500 <= q2Max THEN 25.0 + ((500.0-q1Max)/(q2Max-q1Max)) * 25.0
        WHEN 500 <= q3Max THEN 50.0 + ((500.0-q2Max)/(q3Max-q2Max)) * 25.0
        WHEN 500 <= q4Max THEN 75.0 + ((500.0-q3Max)/(q4Max-q3Max)) * 25.0
        WHEN 500 > q4Max THEN 100.0
        ELSE NULL
    END as percent_not_eligible_fico,
    100.0 - percent_not_eligible_fico as percent_eligible_fico
INTO #FNM_FHA_FICO_Eligible
FROM #FNM_Pool_WAFICOquartile qf
JOIN #FNM_PoolEligibility pe
    ON qf.issueId = pe.issueId
    AND qf.asOf = pe.asOf
WHERE 1=1
    AND pe.fha_eligible IS NULL
;

DROP TABLE IF EXISTS #FNM_FHA_CLTV_Eligible;
SELECT
    ql.issueId,
    ql.asOf,
    CASE 
        WHEN q4Max <= 97.75 THEN 100.0
        WHEN q3Max <= 97.75 THEN 75.0 + ((97.75-q3Max)/(q4Max-q3Max)) * 25.0
        WHEN q2Max <= 97.75 THEN 50.0 + ((97.75-q2Max)/(q3Max-q2Max)) * 25.0
        WHEN q1Max <= 97.75 THEN 25.0 + ((97.75-q1Max)/(q2Max-q1Max)) * 25.0
        WHEN q1Min <= 97.75 THEN 0.0  + ((97.75-q1Min)/(q1Max-q1Min)) * 25.0
        WHEN q1Min > 97.75 THEN 0.0
        ELSE NULL
    END as percent_eligible_ltv,
    100.0 - percent_eligible_ltv as percent_not_eligible_ltv
INTO #FNM_FHA_CLTV_Eligible
FROM #FNM_Pool_WACLTVquartile ql
JOIN #FNM_PoolEligibility pe
    ON ql.issueId = pe.issueId
    AND ql.asOf = pe.asOf
WHERE 1=1
    AND pe.fha_eligible IS NULL
;

  -- Step 2: Combine FICO and CLTV percent not eligible
UPDATE #FNM_PoolEligibility pe SET pe.fha_eligible = 100.0 - (IFNULL(percent_not_eligible_fico, 0.0, percent_not_eligible_fico) + percent_not_eligible_ltv - ((IFNULL(percent_not_eligible_fico, 0.0, percent_not_eligible_fico) / 100.0) * (percent_not_eligible_ltv / 100.0)))
FROM #FNM_FHA_FICO_Eligible fe, #FNM_FHA_CLTV_Eligible ce
WHERE 1=1
    AND pe.issueId = fe.issueId
    AND pe.issueId = ce.issueId
    AND pe.asOf = fe.asOf
    AND pe.asOf = ce.asOf
    AND pe.fha_eligible IS NULL
;

  -- Step 3: Update the FHA elig for the INVESTOR / 2ND part
UPDATE #FNM_PoolEligibility pe SET pe.fha_eligible = pe.fha_eligible * pd.percentOCC_OWN / 100.0
FROM scale.FNM_PoolDistribution pd
WHERE pd.issueId = pe.issueId
AND pd.asof = pe.asof
;
COMMIT;


UPDATE #FNM_PoolEligibility pe SET pe.fha_eligible = CASE WHEN fha_eligible > 100 THEN 100.0 WHEN fha_eligible < 0.0 THEN 0.0 ELSE fha_eligible END;
COMMIT;


  -- Step 4: Update Pools with no Eligibility Information based on FICO/CLTV buckets
DROP TABLE IF EXISTS #FNM_AsOf_FHAEligibleBuckets;
SELECT 
    cltvBucket = case
                    when cltv < 10 THEN 10
                    when cltv >= 140 THEN 150
                    else convert(int, cltv / 10) * 10 + 10
                    end,
	ficoBucket = case 
                    when origFICO < 500 THEN 500
                    when origFICO >= 800 THEN 820
                    else convert(int, origFICO / 20) * 20 + 20
                    end,
    sum(d.fha_eligible * h.balance) / sum(h.balance) as avg_fha_eligible
INTO #FNM_AsOf_FHAEligibleBuckets
FROM #FNM_PoolEligibility d
JOIN scale.FNM_PoolHist h
    ON h.issueId = d.issueId
    AND h.asof = d.asof
WHERE 1=1
    AND conventional_eligible IS NOT NULL
GROUP BY cltvBucket, ficoBucket
ORDER BY cltvBucket, ficoBucket
;
COMMIT;


-- Update the HARPed Pct Estimates
UPDATE #FNM_PoolEligibility pd SET 
    pd.fha_eligible = b.avg_fha_eligible
FROM #FNM_AsOf_FHAEligibleBuckets b
WHERE 1 = 1
    AND pd.cltvBucket = b.cltvBucket
    AND pd.ficoBucket = b.ficoBucket
    AND pd.fha_eligible IS NULL
;
COMMIT;


-- Update Refi Eligibility from Loan Data
DROP TABLE IF EXISTS #FNM_Loan_RefiEligibility;
SELECT
    pe.issueId,
    pe.asOf,
    sum(CASE WHEN sle.HARP_eligible = 1 OR sle.conventional_eligible = 1 OR sle.fha_eligible = 1 THEN clh.balance ELSE 0.0 END) / sum(clh.balance) as refi_eligible
INTO #FNM_Loan_RefiEligibility
FROM #FNM_PoolEligibility pe
JOIN fnm.Cello_Loan cl
    ON pe.issueId = cl.issueId
JOIN scale.fnm_LoanHist clh
    ON cl.loanSeqNum = clh.loanSeqNum
    AND pe.asOf = clh.asOf
JOIN scale.FNM_LoanEligibility sle
    ON clh.loanSeqNum = sle.loanSeqNum
    AND clh.asOf = sle.asOf
WHERE 1=1
    AND (sle.HARP_eligible IS NOT NULL OR sle.conventional_eligible IS NOT NULL OR sle.fha_eligible IS NOT NULL)
GROUP BY pe.issueId, pe.asOf
;
COMMIT;

UPDATE #FNM_PoolEligibility pe SET pe.refi_eligible = 100.0 * re.refi_eligible
FROM #FNM_Loan_RefiEligibility re
WHERE pe.issueId = re.issueId
    AND pe.asOf = re.asOf
;
COMMIT;

--DROP TABLE IF EXISTS #FNM_MIN_RefiEligibility;
