ppdata$himedia_incentive  <- ppdata$incentive
ppdata$lohpa_wala         <- ppdata$wala
ppdata$hihpa_wala         <- ppdata$wala
ppdata$pct_hihpa_wala     <- ppdata$hpa_annual
